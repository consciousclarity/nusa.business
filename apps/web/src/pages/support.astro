---
import Base from "../layouts/Base.astro";
import { absoluteUrl } from "../lib/seo";
import { t, withLocale, type Locale } from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const url = absoluteUrl(Astro.request, withLocale("/support", locale));
const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
---
<Base
  title={t(locale, "supportTitle")}
  description={t(locale, "supportDesc")}
  canonical={url}
  locale={locale}
>
  <section class="lede">
    <h1>{t(locale, "support")}</h1>
    <p class="prose">{t(locale, "supportLede")}</p>
  </section>
  <section class="section">
    <h2>{t(locale, "supportOwnerH2")}</h2>
    <p class="prose">{t(locale, "supportOwner")}</p>
    <p class="actions">
      <a class="cta" href={`${portal}/register?returnTo=${encodeURIComponent("/listings")}`}>
        {t(locale, "addListingOpen")}
      </a>
      <a class="cta secondary" href={`${portal}/login`}>
        {t(locale, "claimLogin")}
      </a>
      <a class="cta secondary" href={withLocale("/claim", locale)}>
        {t(locale, "claimListing")}
      </a>
    </p>
  </section>
</Base>
