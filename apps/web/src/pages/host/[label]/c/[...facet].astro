---
import Base from "../../../../layouts/Base.astro";
import CategoryBrowse from "../../../../components/CategoryBrowse.astro";
import { apiOrNull, apiTry } from "../../../../lib/api";
import { resolveFacetBrowse, searchQueryForBrowse } from "../../../../lib/facet-browse";
import { tenantHref, tenantAbsHref, nationAbsHref } from "../../../../lib/links";
import {
  breadcrumbJsonLd,
  hostPath as seoHostPath,
  websiteJsonLd,
} from "../../../../lib/seo";
import { inWhere, islandName, t, withLocale, type Locale } from "../../../../i18n/ui";
import {
  categoryLabel,
  facetIndexPolicy,
  facetPathSegments,
  facetQueryParams,
  facetValueLabel,
  geoNesting,
  type NestablePlace,
} from "@nusa/shared";

type HubPlace = NestablePlace & { name: string; summary: string };
type BrowseListing = {
  id: string;
  placeId: string;
  slug: string;
  name: string;
  summary: string;
  categories: string[];
  status?: string;
  lat?: number;
  lng?: number;
};

const label = Astro.params.label!;
const facetParam = String(Astro.params.facet ?? "");
const segments = facetParam.split("/").filter(Boolean);
const parts = label.split(".");
const req = Astro.request;
const locale: Locale = Astro.locals.locale ?? "en";

if (parts.length !== 1 && parts.length !== 2) {
  return Astro.redirect(withLocale("/", locale));
}

const resolved = resolveFacetBrowse(segments, Astro.url.searchParams);
if (!resolved.ok) return Astro.rewrite(withLocale("/404", locale));

const islandSlug = parts.length === 2 ? parts[1]! : parts[0]!;
const hostPlaceSlug = parts.length === 2 ? parts[0] : undefined;

const islandDetail = await apiOrNull<{
  island: { slug: string; name: string };
  places: HubPlace[];
}>(`/v1/islands/${islandSlug}`);
if (!islandDetail) return Astro.rewrite(withLocale("/404", locale));

const placesById = Object.fromEntries(
  islandDetail.places.map((p) => [p.id, p]),
);

let hostPlace: HubPlace | undefined;
let area: HubPlace | undefined;

if (hostPlaceSlug) {
  hostPlace = islandDetail.places.find((p) => p.slug === hostPlaceSlug);
  if (!hostPlace) return Astro.rewrite(withLocale("/404", locale));
  const nest = geoNesting(hostPlace, placesById);
  if (nest.area) {
    const segs = facetPathSegments(resolved.browse);
    const q = facetQueryParams(resolved.browse).toString();
    const target = withLocale(
      seoHostPath({
        island: islandSlug,
        place: nest.hostPlace,
        area: nest.area,
        category: resolved.browse.category,
        facet: resolved.browse.pathFacet?.key,
        facetValue: resolved.browse.pathFacet?.value,
      }) + (q ? `?${q}` : ""),
      locale,
    );
    return Astro.redirect(target, 301);
  }
}

if (resolved.promoted) {
  const q = facetQueryParams(resolved.promoted).toString();
  const target = withLocale(
    seoHostPath({
      island: islandSlug,
      place: hostPlaceSlug,
      category: resolved.promoted.category,
      facet: resolved.promoted.pathFacet?.key,
      facetValue: resolved.promoted.pathFacet?.value,
    }) + (q ? `?${q}` : ""),
    locale,
  );
  return Astro.redirect(target, 301);
}

const browse = resolved.browse;
const searchQs = searchQueryForBrowse(islandSlug, hostPlaceSlug, browse);
const search = await apiTry<{
  results: {
    business: BrowseListing;
    place: HubPlace;
    island: { slug: string };
  }[];
}>(`/v1/search?${searchQs}`);
const searchFailed = search === null;

const listings = search?.results.map((r) => r.business) ?? [];
const listingPlaces = Object.fromEntries(
  (search?.results ?? []).map((r) => [r.business.placeId, r.place]),
);
const policy = facetIndexPolicy(browse, {
  resultCount: searchFailed ? 0 : listings.length,
});
const canonical = tenantAbsHref(req, {
  island: islandSlug,
  place: hostPlaceSlug,
  category: browse.category,
  facet:
    policy.canonicalKind === "facet-path" ? browse.pathFacet?.key : undefined,
  facetValue:
    policy.canonicalKind === "facet-path"
      ? browse.pathFacet?.value
      : undefined,
  locale,
});
const islandLabel = islandName(locale, islandSlug, islandDetail.island.name);
const where = hostPlace?.name ?? islandLabel;
const titleCore = browse.pathFacet
  ? `${facetValueLabel(browse.pathFacet.key, browse.pathFacet.value, locale)} ${categoryLabel(browse.category, locale)}`
  : categoryLabel(browse.category, locale);
const formAction = tenantHref(req, {
  island: islandSlug,
  place: hostPlaceSlug,
  category: browse.category,
  locale,
});
---

<Base
  title={`${inWhere(locale, titleCore, where)} — nusa.business`}
  description={`${listings.length} ${categoryLabel(browse.category, locale)} ${t(locale, "listingsCount")} ${t(locale, "inWhere")} ${where}.`}
  crumb={[
    {
      label: islandLabel,
      href: tenantHref(req, { island: islandSlug, locale }),
    },
    ...(hostPlace
      ? [
          {
            label: hostPlace.name,
            href: tenantHref(req, {
              island: islandSlug,
              place: hostPlaceSlug,
              locale,
            }),
          },
        ]
      : []),
    { label: categoryLabel(browse.category, locale) },
    ...(browse.pathFacet
      ? [{ label: facetValueLabel(browse.pathFacet.key, browse.pathFacet.value, locale) }]
      : []),
  ]}
  locale={locale}
  canonical={canonical}
  robots={searchFailed || !policy.index ? "noindex,follow" : "index,follow"}
  jsonLd={[
    websiteJsonLd({
      locale,
      url: canonical,
      name: inWhere(locale, titleCore, where),
      description: `${listings.length} ${t(locale, "listingsCount")} ${t(locale, "inWhere")} ${where}.`,
    }),
    breadcrumbJsonLd([
      { name: "nusa.business", url: nationAbsHref(req, locale) },
      {
        name: islandLabel,
        url: tenantAbsHref(req, { island: islandSlug, locale }),
      },
      ...(hostPlace
        ? [
            {
              name: hostPlace.name,
              url: tenantAbsHref(req, {
                island: islandSlug,
                place: hostPlaceSlug,
                locale,
              }),
            },
          ]
        : []),
      { name: titleCore, url: canonical },
    ]),
  ]}
>
  <CategoryBrowse
    island={islandDetail.island}
    hostPlace={hostPlace}
    area={area}
    places={islandDetail.places}
    listings={listings}
    listingPlaces={listingPlaces}
    browse={browse}
    locale={locale}
    formAction={formAction}
    unavailable={searchFailed}
  />
</Base>
