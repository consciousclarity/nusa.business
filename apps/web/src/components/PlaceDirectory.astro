---
import { geoHref } from "../lib/links";
import { t, placeTypeLabel, type Locale } from "../i18n/ui";
import DirectoryMap from "./DirectoryMap.astro";
import DirectorySearch from "./DirectorySearch.astro";
import { geoView } from "../lib/geo-centroids";
import { listingMarker, takeMarkers } from "../lib/map-markers";
import {
  canonicalizeCategory,
  categoryLabel,
  listingMatchesCategory,
  relatedAsLabel,
  relatedForCategory,
} from "@nusa/shared";

export type PlaceHubPlace = {
  id: string;
  slug: string;
  name: string;
  summary: string;
  type: "kabupaten" | "kota" | "tourist_area";
  parentPlaceId?: string;
};

export type PlaceHubBusiness = {
  slug: string;
  name: string;
  summary: string;
  categories: string[];
  status?: string;
  sample?: boolean;
  fieldRegistered?: boolean;
  lat?: number;
  lng?: number;
};

type Props = {
  island: { slug: string; name: string };
  place: PlaceHubPlace;
  parent?: PlaceHubPlace | null;
  children?: PlaceHubPlace[];
  businesses: PlaceHubBusiness[];
  queryHost: string;
  locale: Locale;
  categoryParam: string;
};

const {
  island,
  place,
  parent = null,
  children = [],
  businesses,
  queryHost,
  locale,
  categoryParam,
} = Astro.props as Props;

const req = Astro.request;
const graph: PlaceHubPlace[] = [
  place,
  ...(parent ? [parent] : []),
  ...children,
];

const recent = businesses.filter((b) => b.fieldRegistered).slice(0, 5);

const activeCategory = canonicalizeCategory(categoryParam) ?? "";

const placeBusinesses = activeCategory
  ? businesses.filter((b) => listingMatchesCategory(b.categories, activeCategory))
  : businesses;

const relatedShown = activeCategory ? relatedForCategory(activeCategory) : [];
const activeCategoryLabel = activeCategory ? categoryLabel(activeCategory, locale) : "";

const placeMarkers = takeMarkers(
  placeBusinesses.map((b) =>
    listingMarker({
      lat: b.lat,
      lng: b.lng,
      name: b.name,
      href: geoHref(req, {
        island: island.slug,
        place,
        places: graph,
        slug: b.slug,
        locale,
      }),
    }),
  ),
);
const placeFallback = geoView(island.slug);
---

<section class="lede">
  <h1>{place.name}</h1>
  <p class="prose">{place.summary}</p>
  {parent && (
    <p class="meta">
      {t(locale, "partOf")}{" "}
      <a href={geoHref(req, { island: island.slug, place: parent, places: graph, locale })}>
        {parent.name}
      </a>
    </p>
  )}
</section>

<DirectorySearch
  locale={locale}
  island={island.slug}
  category={activeCategory}
  lockIsland
/>

<aside class="banner" aria-label={t(locale, "listingsCount")}>
  {placeBusinesses.length} {t(locale, "listingsCount")}
  {activeCategory ? ` · ${activeCategoryLabel}` : ""}
  {activeCategory && businesses.length !== placeBusinesses.length
    ? ` · ${businesses.length}`
    : ""}
</aside>

<DirectoryMap
  label={t(locale, "directoryMap")}
  markers={placeMarkers}
  fallback={placeFallback}
/>

{recent.length > 0 && (
  <div class="banner">
    {t(locale, "justRegistered")}{" "}
    {recent.map((b, i) => (
      <>
        {i > 0 && " · "}
        <a
          href={geoHref(req, {
            island: island.slug,
            place,
            places: graph,
            slug: b.slug,
            locale,
          })}
        >
          {b.name}
        </a>
      </>
    ))}
  </div>
)}

{children.length > 0 && (
  <section class="section">
    <h2>{t(locale, "areasIn")} {place.name}</h2>
    <ol class="index-list">
      {children.map((child, i) => (
        <li>
          <div class="index-row">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <a
              class="name"
              href={geoHref(req, {
                island: island.slug,
                place: child,
                places: graph,
                locale,
              })}
            >
              {child.name}
            </a>
            <span class="rhs">{placeTypeLabel(locale, child.type)}</span>
          </div>
          <p class="index-desc">{child.summary}</p>
        </li>
      ))}
    </ol>
  </section>
)}

)}

{relatedShown.length > 0 && (
  <p class="meta">
    {t(locale, "relatedServices")}{" "}
    {relatedShown.map((rel) => relatedAsLabel(rel.as, locale)).join(" · ")}
  </p>
)}

<section class="section">
  <h2>
    {t(locale, "businessesIn")} {place.name}
    {activeCategory ? ` · ${activeCategoryLabel}` : ""}
  </h2>
  {placeBusinesses.length === 0 ? (
    <p class="prose">
      {t(locale, "noCategoryMatches")}{" "}
      <a
        href={geoHref(req, {
          island: island.slug,
          place,
          places: graph,
          locale,
        })}
      >
        {t(locale, "showAll")}
      </a>
    </p>
  ) : (
    <ol class="index-list">
      {placeBusinesses.map((b, i) => (
        <li>
          <div class="index-row">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <a
              class="name"
              href={geoHref(req, {
                island: island.slug,
                place,
                places: graph,
                slug: b.slug,
                locale,
              })}
            >
              {b.name}
            </a>
            <span class="rhs">
              {b.sample ? (
                <span class="stamp">{t(locale, "sampleListing")}</span>
              ) : b.status === "draft" ? (
                <span class="stamp">{t(locale, "listedUnclaimed")}</span>
              ) : (
                categoryLabel(b.categories[0] ?? "", locale)
              )}
            </span>
          </div>
          <p class="index-desc">{b.summary}</p>
        </li>
      ))}
    </ol>
  )}
</section>
