---
import Base from "../../../layouts/Base.astro";
import { api } from "../../../lib/api";
import { tenantHref } from "../../../lib/links";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  hostPath,
  websiteJsonLd,
} from "../../../lib/seo";
import { t, withLocale, type Locale } from "../../../i18n/ui";
import { CATEGORIES } from "@nusa/shared";

const label = Astro.params.label!;
const parts = label.split(".");
const req = Astro.request;
const locale: Locale = Astro.locals.locale ?? "en";
const categoryParam = (Astro.url.searchParams.get("category") || "").trim();

type IslandPayload = {
  island: { slug: string; name: string; tagline: string; status?: string };
  places: { id: string; slug: string; name: string; summary: string; type: string }[];
  businesses: {
    id: string;
    placeId: string;
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
  }[];
};

type PlacePayload = {
  island: { slug: string; name: string };
  place: { slug: string; name: string; summary: string; type: string };
  businesses: {
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
    registeredByAgentId?: string;
  }[];
};

let mode: "island" | "place" | "none" = "none";
let islandData: IslandPayload | null = null;
let placeData: PlacePayload | null = null;

if (parts.length === 1) {
  mode = "island";
  islandData = await api<IslandPayload>(`/v1/islands/${parts[0]}`);
} else if (parts.length === 2) {
  mode = "place";
  placeData = await api<PlacePayload>(
    `/v1/islands/${parts[1]}/places/${parts[0]}`,
  );
} else {
  return Astro.redirect(withLocale("/", locale));
}

const placeById = islandData
  ? Object.fromEntries(islandData.places.map((p) => [p.id, p]))
  : {};
const recent =
  placeData?.businesses.filter((b) => b.registeredByAgentId).slice(0, 5) ?? [];

const placeCategories = placeData
  ? [
      ...new Set(
        placeData.businesses.flatMap((b) => b.categories).filter(Boolean),
      ),
    ].sort((a, b) => a.localeCompare(b))
  : [];

const activeCategory =
  categoryParam &&
  (placeCategories.includes(categoryParam) ||
    (CATEGORIES as readonly string[]).includes(categoryParam))
    ? categoryParam
    : "";

const placeBusinesses = placeData
  ? activeCategory
    ? placeData.businesses.filter((b) => b.categories.includes(activeCategory))
    : placeData.businesses
  : [];

const queryHost =
  mode === "island" && islandData
    ? `${islandData.island.slug}.nusa.business`
    : mode === "place" && placeData
      ? `${placeData.place.slug}.${placeData.island.slug}.nusa.business`
      : label;

const islandCanonical =
  islandData &&
  absoluteUrl(
    req,
    withLocale(hostPath({ island: islandData.island.slug }), locale),
  );
const placeCanonical =
  placeData &&
  absoluteUrl(
    req,
    withLocale(
      hostPath({
        island: placeData.island.slug,
        place: placeData.place.slug,
      }),
      locale,
    ),
  );
---

{mode === "island" && islandData && (
  <Base
    title={`${islandData.island.name} — nusa.business`}
    description={islandData.island.tagline}
    crumb={[{ label: islandData.island.slug }]}
    locale={locale}
    canonical={islandCanonical!}
    jsonLd={[
      websiteJsonLd({
        url: islandCanonical!,
        name: `${islandData.island.name} — nusa.business`,
        description: islandData.island.tagline,
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: absoluteUrl(req, withLocale("/", locale)) },
        { name: islandData.island.name, url: islandCanonical! },
      ]),
    ]}
  >
    <section class="lede">
      <h1>{islandData.island.name}</h1>
      <p class="prose">{islandData.island.tagline}</p>
    </section>

    <aside class="resolver" aria-label={t(locale, "hostResolver")}>
      <dl>
        <dt>{t(locale, "query")}</dt>
        <dd>{queryHost}</dd>
        <dt>{t(locale, "resolved")}</dt>
        <dd>island={islandData.island.slug}</dd>
        <dt>{t(locale, "records")}</dt>
        <dd>
          {islandData.places.length} places · {islandData.businesses.length} listings
        </dd>
      </dl>
    </aside>

    <section class="section">
      <h2>{t(locale, "places")}</h2>
      <ol class="index-list">
        {islandData.places.map((place, i) => (
          <li>
            <div class="index-row">
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <a
                class="name"
                href={tenantHref(req, { island: islandData!.island.slug,                   place: place.slug, locale })}
              >
                {place.name}
              </a>
              <span class="rhs">{place.type.replaceAll("_", " ")}</span>
            </div>
            <p class="index-desc">{place.summary}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section">
      <h2>{t(locale, "featured")}</h2>
      <ol class="index-list">
        {islandData.businesses.slice(0, 9).map((b, i) => {
          const place = placeById[b.placeId];
          return (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a
                  class="name"
                  href={
                    place
                      ? tenantHref(req, { island: islandData!.island.slug,                           place: place.slug,                           slug: b.slug, locale })
                      : "#"
                  }
                >
                  {b.name}
                </a>
                <span class="rhs">{place?.name ?? ""}</span>
              </div>
              <p class="index-desc">{b.summary}</p>
            </li>
          );
        })}
      </ol>
    </section>
  </Base>
)}

{mode === "place" && placeData && (
  <Base
    title={`${placeData.place.name}, ${placeData.island.name} — nusa.business`}
    description={placeData.place.summary}
    crumb={[
      {
        label: placeData.island.slug,
        href: tenantHref(req, { island: placeData.island.slug, locale }),
      },
      { label: placeData.place.slug },
    ]}
    locale={locale}
    canonical={placeCanonical!}
    jsonLd={[
      websiteJsonLd({
        url: placeCanonical!,
        name: `${placeData.place.name}, ${placeData.island.name}`,
        description: placeData.place.summary,
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: absoluteUrl(req, withLocale("/", locale)) },
        {
          name: placeData.island.name,
          url: absoluteUrl(
            req,
            withLocale(hostPath({ island: placeData.island.slug }), locale),
          ),
        },
        { name: placeData.place.name, url: placeCanonical! },
      ]),
    ]}
  >
    <section class="lede">
      <h1>{placeData.place.name}</h1>
      <p class="prose">{placeData.place.summary}</p>
    </section>

    <aside class="resolver" aria-label={t(locale, "hostResolver")}>
      <dl>
        <dt>{t(locale, "query")}</dt>
        <dd>{queryHost}</dd>
        <dt>{t(locale, "resolved")}</dt>
        <dd>
          island={placeData.island.slug} · place={placeData.place.slug} · type=
          {placeData.place.type}
        </dd>
        <dt>{t(locale, "records")}</dt>
        <dd>
          {placeBusinesses.length}
          {activeCategory
            ? ` in ${activeCategory}`
            : ` published`}
          {activeCategory && placeData.businesses.length !== placeBusinesses.length
            ? ` · ${placeData.businesses.length} total`
            : ""}
        </dd>
      </dl>
    </aside>

    {recent.length > 0 && (
      <div class="banner">
        {t(locale, "justRegistered")}{" "}
        {recent.map((b, i) => (
          <>
            {i > 0 && " · "}
            <a
              href={tenantHref(req, {
                island: placeData!.island.slug,
                place: placeData!.place.slug,
                slug: b.slug,
                locale,
              })}
            >
              {b.name}
            </a>
          </>
        ))}
      </div>
    )}

    {placeCategories.length > 1 && (
      <form class="section filter-bar" method="get">
        <label>
          {t(locale, "category")}
          <select name="category" onchange="this.form.submit()">
            <option value="">{t(locale, "allCategories")}</option>
            {placeCategories.map((cat) => (
              <option value={cat} selected={cat === activeCategory}>
                {cat}
              </option>
            ))}
          </select>
        </label>
        <noscript>
          <button type="submit">{t(locale, "apply")}</button>
        </noscript>
      </form>
    )}

    <section class="section">
      <h2>
        {t(locale, "businessesIn")} {placeData.place.name}
        {activeCategory ? ` · ${activeCategory}` : ""}
      </h2>
      {placeBusinesses.length === 0 ? (
        <p class="prose">
          {t(locale, "noCategoryMatches")}{" "}
          <a
            href={tenantHref(req, {
              island: placeData.island.slug,
              place: placeData.place.slug,
              locale,
            })}
          >
            {t(locale, "showAll")}
          </a>
        </p>
      ) : (
        <ol class="index-list">
          {placeBusinesses.map((b, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a
                  class="name"
                  href={tenantHref(req, {
                    island: placeData!.island.slug,
                    place: placeData!.place.slug,
                    slug: b.slug,
                    locale,
                  })}
                >
                  {b.name}
                </a>
                <span class="rhs">
                  {b.status === "draft" ? (
                    <span class="stamp">Unclaimed</span>
                  ) : (
                    b.categories[0] ?? ""
                  )}
                </span>
              </div>
              <p class="index-desc">{b.summary}</p>
            </li>
          ))}
        </ol>
      )}
    </section>
  </Base>
)}
