---
import Base from "../layouts/Base.astro";
import { absoluteUrl } from "../lib/seo";
import { t, withLocale, type Locale } from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
const claimUrl = absoluteUrl(Astro.request, withLocale("/claim", locale));
const claimReturn = encodeURIComponent("/claim");
const addReturn = encodeURIComponent("/listings");
---
<Base
  title={t(locale, "claimTitle")}
  description={t(locale, "claimLede")}
  canonical={claimUrl}
  locale={locale}
>
  <section class="lede">
    <h1>{t(locale, "claimH1")}</h1>
    <p class="prose">{t(locale, "claimLede")}</p>
  </section>

  <section class="section">
    <h2>{t(locale, "claimListing")}</h2>
    <p class="prose">{t(locale, "claimExistingHelp")}</p>
    <p class="actions">
      <a class="cta" href={`${portal}/claim`}>{t(locale, "claimOpen")}</a>
      <a
        class="cta secondary"
        href={`${portal}/login?returnTo=${claimReturn}`}
      >
        {t(locale, "claimLogin")}
      </a>
    </p>
  </section>

  <section class="section">
    <h2>{t(locale, "addListing")}</h2>
    <p class="prose">{t(locale, "addListingHelp")}</p>
    <p class="actions">
      <a class="cta secondary" href={`${portal}/register?returnTo=${addReturn}`}>
        {t(locale, "addListingOpen")}
      </a>
      <a class="cta secondary" href={`${portal}/register`}>
        {t(locale, "claimInvite")}
      </a>
    </p>
  </section>
</Base>
