---
import Base from "../../../layouts/Base.astro";
import { api, browserApiOrigin } from "../../../lib/api";
import { tenantHref } from "../../../lib/links";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  hostPath as seoHostPath,
  localBusinessJsonLd,
} from "../../../lib/seo";
import { t, withLocale, type Locale } from "../../../i18n/ui";
import { telHref, whatsappHref } from "@nusa/shared";

const label = Astro.params.label!;
const slug = Astro.params.slug!;
const parts = label.split(".");
if (parts.length !== 2) return Astro.redirect(`/host/${label}`);

const [placeSlug, islandSlug] = parts;
const req = Astro.request;
const locale: Locale = Astro.locals.locale ?? "en";
const data = await api<{
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    description: string;
    categories: string[];
    address?: string;
    phone?: string;
    whatsapp?: string;
    website?: string;
    bookingMode: string;
    status: string;
    openingHours: { day: string; open: string; close: string; closed?: boolean }[];
  };
  reviews: {
    authorName: string;
    service: number;
    value: number;
    location: number;
    cleanliness: number;
    comment: string;
  }[];
  vendor?: {
    id: string;
    name: string;
    description: string;
    products: { name: string; price: number; currency: string; stock: number; description: string }[];
  };
}>(`/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}`);

const placeMeta = await api<{
  island: { name: string; slug: string };
  place: { name: string; slug: string };
}>(`/v1/islands/${islandSlug}/places/${placeSlug}`);

const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
const hostPath = `${placeSlug}.${islandSlug}.nusa.business/${slug}`;
const listingPath = withLocale(
  seoHostPath({
    island: islandSlug!,
    place: placeSlug!,
    slug,
  }),
  locale,
);
const listingUrl = absoluteUrl(req, listingPath);
const stamp =
  data.business.status === "draft"
    ? "Unclaimed"
    : data.business.status === "published"
      ? null
      : null;

const wa = whatsappHref(data.business.whatsapp);
const phoneLink = telHref(data.business.phone);

type DiscoveryNeighbor = {
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    categories: string[];
    lat?: number;
    lng?: number;
  };
  place: { slug: string; name: string };
  island: { slug: string };
  distanceKm: number;
};

type DiscoveryPayload = {
  origin: { lat: number; lng: number; address?: string } | null;
  sameAddress: DiscoveryNeighbor[];
  similar: DiscoveryNeighbor[];
  nearbyCategories: string[];
  nearby: DiscoveryNeighbor[];
  activeCategory: string | null;
  radiusKm: number;
};

const discovery = await api<DiscoveryPayload>(
  `/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}/discovery`,
);

function neighborHref(n: DiscoveryNeighbor) {
  return tenantHref(req, {
    island: n.island.slug,
    place: n.place.slug,
    slug: n.business.slug,
    locale,
  });
}

const discoveryApi = `${browserApiOrigin()}/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}/discovery`;
const nearbyWithHref = discovery.nearby.map((n) => ({
  ...n,
  href: neighborHref(n),
}));
---
<Base
  title={`${data.business.name} — ${placeMeta.place.name}`}
  description={data.business.summary}
  crumb={[
    { label: islandSlug!, href: tenantHref(req, { island: islandSlug!, locale }) },
    {
      label: placeSlug!,
      href: tenantHref(req, { island: islandSlug!, place: placeSlug!, locale }),
    },
    { label: data.business.slug },
  ]}
  locale={locale}
  canonical={listingUrl}
  ogType="article"
  jsonLd={[
    localBusinessJsonLd({
      name: data.business.name,
      description: data.business.summary,
      url: listingUrl,
      address: data.business.address,
      telephone: data.business.phone,
      categories: data.business.categories,
    }),
    breadcrumbJsonLd([
      { name: "nusa.business", url: absoluteUrl(req, withLocale("/", locale)) },
      {
        name: placeMeta.island.name,
        url: absoluteUrl(
          req,
          withLocale(seoHostPath({ island: islandSlug! }), locale),
        ),
      },
      {
        name: placeMeta.place.name,
        url: absoluteUrl(
          req,
          withLocale(
            seoHostPath({ island: islandSlug!, place: placeSlug! }),
            locale,
          ),
        ),
      },
      { name: data.business.name, url: listingUrl },
    ]),
  ]}
>
  <article class="record">
    <h1>{data.business.name}</h1>
    <p class="prose">{data.business.summary}</p>
    {stamp && <span class="stamp">{stamp}</span>}

    <dl class="kv">
      <dt>Host</dt>
      <dd>{hostPath}</dd>
      <dt>{t(locale, "category")}</dt>
      <dd>{data.business.categories.join(" · ") || "—"}</dd>
      {data.business.address && (
        <>
          <dt>Address</dt>
          <dd>{data.business.address}</dd>
        </>
      )}
      {data.business.phone && (
        <>
          <dt>Phone</dt>
          <dd>
            {phoneLink ? (
              <a href={phoneLink}>{data.business.phone}</a>
            ) : (
              data.business.phone
            )}
          </dd>
        </>
      )}
      {data.business.whatsapp && (
        <>
          <dt>WhatsApp</dt>
          <dd>
            {wa ? (
              <a href={wa} rel="noopener noreferrer">
                {data.business.whatsapp}
              </a>
            ) : (
              data.business.whatsapp
            )}
          </dd>
        </>
      )}
      <dt>Booking</dt>
      <dd>{data.business.bookingMode}</dd>
      <dt>Status</dt>
      <dd>{data.business.status}</dd>
    </dl>

    <p class="actions">
      {wa && (
        <a class="cta" href={wa} rel="noopener noreferrer">
          {t(locale, "chatWhatsApp")}
        </a>
      )}
      {phoneLink && (
        <a class={`cta${wa ? " secondary" : ""}`} href={phoneLink}>
          {t(locale, "call")}
        </a>
      )}
      <a
        class={`cta${wa || phoneLink ? " secondary" : ""}`}
        href={`${portal}/claim?businessId=${data.business.id}`}
      >
        {t(locale, "claimThis")}
      </a>
      {data.business.bookingMode !== "none" && (
        <a class="cta secondary" href="#book">{t(locale, "book")} ({data.business.bookingMode})</a>
      )}
    </p>
  </article>

  <div class="stack">
    <section class="section">
      <h2>{t(locale, "overview")}</h2>
      <p class="prose">{data.business.description}</p>
    </section>

    {discovery.sameAddress.length > 0 && (
      <section class="section" aria-labelledby="same-address-heading">
        <h2 id="same-address-heading">{t(locale, "otherAtAddress")}</h2>
        <p class="meta">{data.business.address}</p>
        <ol class="index-list">
          {discovery.sameAddress.map((n, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={neighborHref(n)}>{n.business.name}</a>
                <span class="rhs">{n.business.categories[0] ?? n.place.name}</span>
              </div>
              <p class="index-desc">{n.business.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {discovery.similar.length > 0 && (
      <section class="section" aria-labelledby="similar-heading">
        <h2 id="similar-heading">{t(locale, "similarNearby")}</h2>
        <ol class="index-list">
          {discovery.similar.map((n, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={neighborHref(n)}>{n.business.name}</a>
                <span class="rhs">
                  {n.distanceKm.toFixed(2)} {t(locale, "kmAway")} · {n.place.name}
                </span>
              </div>
              <p class="index-desc">{n.business.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {discovery.origin && discovery.nearbyCategories.length > 0 && (
      <section
        class="section nearby-discovery"
        aria-labelledby="nearby-cat-heading"
        data-nearby-root
        data-endpoint={discoveryApi}
        data-active-category={discovery.activeCategory ? encodeURIComponent(discovery.activeCategory) : ""}
        data-empty-label={t(locale, "noNearbyInCategory")}
      >
        <h2 id="nearby-cat-heading">{t(locale, "nearbyByCategory")}</h2>
        <div
          class="category-chips"
          role="group"
          aria-label={t(locale, "category")}
        >
          {discovery.nearbyCategories.map((cat) => (
            <button
              type="button"
              class:list={["chip", { "is-active": cat === discovery.activeCategory }]}
              data-category={encodeURIComponent(cat)}
              aria-pressed={cat === discovery.activeCategory ? "true" : "false"}
            >
              {cat}
            </button>
          ))}
        </div>
        <div class="nearby-layout">
          <div
            class="nearby-map"
            data-nearby-map
            role="img"
            aria-label={t(locale, "nearbyMap")}
          ></div>
          <div data-nearby-list>
            {nearbyWithHref.length === 0 ? (
              <p class="meta">{t(locale, "noNearbyInCategory")}</p>
            ) : (
              <ol class="index-list">
                {nearbyWithHref.map((n, i) => (
                  <li>
                    <div class="index-row">
                      <span class="n">{String(i + 1).padStart(2, "0")}</span>
                      <a class="name" href={n.href}>{n.business.name}</a>
                      <span class="rhs">
                        {n.distanceKm.toFixed(2)} {t(locale, "kmAway")}
                      </span>
                    </div>
                    <p class="index-desc">{n.business.summary}</p>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      </section>
    )}

    {data.business.openingHours?.length > 0 && (
      <section class="section" aria-labelledby="hours-caption">
        <div class="table-wrap">
          <table class="data">
            <caption id="hours-caption">{t(locale, "openingHours")}</caption>
            <thead>
              <tr>
                <th scope="col">{t(locale, "day")}</th>
                <th scope="col">{t(locale, "hours")}</th>
              </tr>
            </thead>
            <tbody>
              {data.business.openingHours.map((h) => (
                <tr>
                  <th scope="row">{h.day}</th>
                  <td>{h.closed ? t(locale, "closed") : `${h.open} – ${h.close}`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {data.vendor && (
      <section class="section">
        <h2>Shop · {data.vendor.name}</h2>
        <p class="prose">{data.vendor.description}</p>
        <p class="meta">Vendor store · 0% commission at launch</p>
        <ol class="index-list">
          {data.vendor.products.map((p, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <span class="name">{p.name}</span>
                <span class="rhs">
                  {p.price.toLocaleString("id-ID")} {p.currency} · stock {p.stock}
                </span>
              </div>
              <p class="index-desc">{p.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="section" id="reviews">
      <h2>{t(locale, "reviews")}</h2>
      {data.reviews.length === 0 && <p class="meta">No reviews yet.</p>}
      {data.reviews.length > 0 && (
        <div class="table-wrap">
          <table class="data">
            <caption>Review scores</caption>
            <thead>
              <tr>
                <th scope="col">Author</th>
                <th scope="col">Service</th>
                <th scope="col">Value</th>
                <th scope="col">Location</th>
                <th scope="col">Cleanliness</th>
              </tr>
            </thead>
            <tbody>
              {data.reviews.map((r) => (
                <tr>
                  <th scope="row">{r.authorName}</th>
                  <td>{r.service}/5</td>
                  <td>{r.value}/5</td>
                  <td>{r.location}/5</td>
                  <td>{r.cleanliness}/5</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {data.reviews.map((r) => (
        <p class="prose review-note">
          <strong>{r.authorName}:</strong> {r.comment}
        </p>
      ))}

      <form class="stack" method="POST" id="review-form">
        <h3>Add review</h3>
        <label>Name <input name="authorName" required autocomplete="nickname" /></label>
        <label>Comment <textarea name="comment" required rows="3"></textarea></label>
        <fieldset class="scores">
          <legend>Scores (1–5)</legend>
          <label>Service <input type="number" name="service" min="1" max="5" value="5" required /></label>
          <label>Value <input type="number" name="value" min="1" max="5" value="5" required /></label>
          <label>Location <input type="number" name="location" min="1" max="5" value="5" required /></label>
          <label>
            Cleanliness
            <input type="number" name="cleanliness" min="1" max="5" value="5" required />
          </label>
        </fieldset>
        <button type="submit">Submit review</button>
        <p class="meta" id="review-msg" role="status" aria-live="polite"></p>
      </form>
    </section>

    {data.business.bookingMode !== "none" && (
      <section class="section" id="book">
        <h2>Request a booking · {data.business.bookingMode}</h2>
        <p class="meta" id="booking-notice">
          Sends a pending request to the business. This is not a confirmed
          reservation and does not lock a price or inventory.
        </p>
        <form
          class="stack"
          id="booking-form"
          aria-describedby="booking-notice"
        >
          <label>Name <input name="customerName" required autocomplete="name" /></label>
          <label>Email <input type="email" name="customerEmail" required autocomplete="email" /></label>
          <label>Date <input type="date" name="startDate" required /></label>
          {data.business.bookingMode === "service" && (
            <label>Time slot <input name="timeSlot" placeholder="10:00" /></label>
          )}
          {data.business.bookingMode === "rental" && (
            <label>End date <input type="date" name="endDate" /></label>
          )}
          {data.business.bookingMode === "event" && (
            <label>Tickets <input type="number" name="tickets" min="1" value="1" /></label>
          )}
          <button type="submit">Submit request</button>
          <p class="meta" id="booking-msg" role="status" aria-live="polite"></p>
        </form>
      </section>
    )}
  </div>
</Base>

<script define:vars={{ apiBase: browserApiOrigin(), businessId: data.business.id }}>
  function setStatus(el, text, isError) {
    if (!el) return;
    el.textContent = text;
    el.classList.toggle("error", !!isError);
    const form = el.closest("form");
    if (form) {
      if (isError) form.setAttribute("aria-invalid", "true");
      else form.removeAttribute("aria-invalid");
    }
  }

  function lockForm(form, locked) {
    form.querySelectorAll("button, input, textarea, select").forEach((node) => {
      node.disabled = locked;
    });
  }

  const reviewForm = document.getElementById("review-form");
  const reviewMsg = document.getElementById("review-msg");
  reviewForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (reviewForm.dataset.busy === "1") return;
    const fd = new FormData(reviewForm);
    reviewForm.dataset.busy = "1";
    lockForm(reviewForm, true);
    setStatus(reviewMsg, "Submitting review…", false);
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/reviews`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          authorName: fd.get("authorName"),
          comment: fd.get("comment"),
          service: Number(fd.get("service")),
          value: Number(fd.get("value")),
          location: Number(fd.get("location")),
          cleanliness: Number(fd.get("cleanliness")),
        }),
      });
      if (res.ok) {
        location.reload();
        return;
      }
      let detail = `Review failed (${res.status}).`;
      try {
        const data = await res.json();
        if (data?.error) detail = data.error;
      } catch {}
      if (res.status === 429) {
        const ra = res.headers.get("Retry-After");
        detail = ra ? `Too many reviews — retry in ${ra}s.` : "Too many reviews — try later.";
      }
      setStatus(reviewMsg, detail, true);
    } catch {
      setStatus(reviewMsg, "Network error — check your connection and try again.", true);
    } finally {
      reviewForm.dataset.busy = "0";
      lockForm(reviewForm, false);
    }
  });

  const bookingForm = document.getElementById("booking-form");
  const bookingMsg = document.getElementById("booking-msg");
  let bookingIdempotencyKey = crypto.randomUUID();
  let lastBookingPayload;
  bookingForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (bookingForm.dataset.busy === "1") return;
    // Disabled controls are omitted by FormData, so capture values before locking.
    const fd = new FormData(bookingForm);
    bookingForm.dataset.busy = "1";
    lockForm(bookingForm, true);
    setStatus(bookingMsg, "Sending request…", false);
    const payload = {
      customerName: fd.get("customerName"),
      customerEmail: fd.get("customerEmail"),
      startDate: fd.get("startDate"),
      endDate: fd.get("endDate") || undefined,
      timeSlot: fd.get("timeSlot") || undefined,
      tickets: fd.get("tickets") ? Number(fd.get("tickets")) : undefined,
    };
    const serializedPayload = JSON.stringify(payload);
    if (lastBookingPayload !== undefined && lastBookingPayload !== serializedPayload) {
      bookingIdempotencyKey = crypto.randomUUID();
    }
    lastBookingPayload = serializedPayload;
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/bookings`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "idempotency-key": bookingIdempotencyKey,
        },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        const data = await res.json();
        const notice =
          data.notice ||
          "Request recorded as pending. This is not a confirmed reservation.";
        setStatus(
          bookingMsg,
          `Request ${data.booking.id} submitted (${data.booking.status}). ${notice}`,
          false,
        );
        bookingForm.reset();
        bookingIdempotencyKey = crypto.randomUUID();
      } else {
        let detail = `Request failed (${res.status}).`;
        try {
          const data = await res.json();
          if (data?.error) detail = data.error;
        } catch {}
        if (res.status === 429) {
          const ra = res.headers.get("Retry-After");
          detail = ra
            ? `Too many requests — retry in ${ra}s. Your form was kept.`
            : "Too many requests — try later. Your form was kept.";
        }
        setStatus(bookingMsg, detail, true);
      }
    } catch {
      setStatus(
        bookingMsg,
        "Network error — your details were kept. Try again.",
        true,
      );
    } finally {
      bookingForm.dataset.busy = "0";
      lockForm(bookingForm, false);
    }
  });
</script>

<script>
  import { mountNearbyDiscovery } from "../../../scripts/nearby-discovery";
  const root = document.querySelector("[data-nearby-root]");
  if (root instanceof HTMLElement) mountNearbyDiscovery(root);
</script>
