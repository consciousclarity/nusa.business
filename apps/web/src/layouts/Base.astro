---
import "../styles/global.css";
import { nationHref } from "../lib/links";
import { absoluteUrl, type JsonLd } from "../lib/seo";
import {
  alternateLocale,
  detectLocale,
  t,
  withLocale,
  type Locale,
} from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  crumb?: { label: string; href?: string }[];
  locale?: Locale;
  /** Absolute canonical URL; defaults to the current request URL. */
  canonical?: string;
  ogType?: string;
  jsonLd?: JsonLd;
  /** Defaults to index,follow. Use noindex,follow for thin filter combinations. */
  robots?: string;
}

const locale: Locale =
  Astro.props.locale ?? Astro.locals.locale ?? "en";
const { title, description, crumb = [], ogType = "website", jsonLd, robots } =
  Astro.props;
const portalUrl = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
const homeHref = nationHref(Astro.request, locale);
const { pathWithoutLocale } = detectLocale(Astro.url.pathname);
const other = alternateLocale(locale);
const pathWithSearch = pathWithoutLocale + Astro.url.search;
const enHref = absoluteUrl(Astro.request, withLocale(pathWithSearch, "en"));
const idHref = absoluteUrl(Astro.request, withLocale(pathWithSearch, "id"));
const switchHref = withLocale(pathWithSearch, other);
const ogLocale = locale === "id" ? "id_ID" : "en_GB";
const ogLocaleAlt = locale === "id" ? "en_GB" : "id_ID";
const metaDescription =
  description || t(locale, "metaDescription");
const canonical =
  Astro.props.canonical ||
  absoluteUrl(Astro.request, Astro.url.pathname + Astro.url.search);
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots || "index,follow"} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="id" href={idHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta property="og:site_name" content="nusa.business" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <title>{title}</title>
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, "skipToContent")}</a>
    <header class="site-header">
      <a class="brand" href={homeHref}>nusa<span class="tld">.business</span></a>
      <nav aria-label={t(locale, "navPrimary")}>
        <a class="nav-search" href={withLocale("/search", locale)}>{t(locale, "search")}</a>
        <a class="nav-search" href={`${withLocale("/claim", locale)}#add`}>{t(locale, "navAdd")}</a>
        <a class="nav-owner" href={`${withLocale("/claim", locale)}#claim`}>{t(locale, "navClaim")}</a>
        <a
          class="nav-lang"
          href={switchHref}
          lang={other}
          hreflang={other}
          aria-label={t(locale, "langSwitchAria")}
        >
          <svg
            class="nav-lang-mark"
            aria-hidden="true"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M2 12h20"></path>
            <path d="M12 2a15 15 0 0 1 0 20"></path>
            <path d="M12 2a15 15 0 0 0 0 20"></path>
          </svg>
          {t(locale, "langSwitch")}
        </a>
      </nav>
    </header>
    <nav class="crumbs" aria-label={t(locale, "navPath")}>
      <a href={homeHref}>nusa.business</a>
      {crumb.map((c) => (
        <>
          <span class="sep" aria-hidden="true">/</span>
          {c.href ? (
            <a href={c.href}>{c.label}</a>
          ) : (
            <span class="here" aria-current="page">{c.label}</span>
          )}
        </>
      ))}
    </nav>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t(locale, "footer")}</p>
      <p>
        <a href={withLocale("/privacy", locale)}>{t(locale, "privacy")}</a>
        <span aria-hidden="true"> · </span>
        <a href={withLocale("/terms", locale)}>{t(locale, "terms")}</a>
        <span aria-hidden="true"> · </span>
        <a href={withLocale("/support", locale)}>{t(locale, "support")}</a>
        <span aria-hidden="true"> · </span>
        <a href={withLocale("/claim", locale)}>{t(locale, "claimListing")}</a>
        <span aria-hidden="true"> · </span>
        <a href={portalUrl}>{t(locale, "navPortal")}</a>
      </p>
    </footer>
  </body>
</html>
