---
import DirectoryMap from "./DirectoryMap.astro";
import { t, weekdayLabel, type Locale } from "../i18n/ui";
import type { DirectoryMapMarker } from "../lib/map-markers";
import {
  categoryLabel,
  listingHoursStatus,
  mapsHref,
  telHref,
  websiteHref,
  whatsappHref,
} from "@nusa/shared";

export type ListingBusiness = {
  id: string;
  name: string;
  slug: string;
  summary: string;
  description: string;
  categories: string[];
  address?: string;
  phone?: string;
  whatsapp?: string;
  website?: string;
  lat?: number;
  lng?: number;
  gallery?: string[];
  bookingMode: string;
  status: string;
  sample?: boolean;
  verifiedAt?: string;
  openingHours: { day: string; open: string; close: string; closed?: boolean }[];
};

export type ListingReview = {
  authorName: string;
  service: number;
  value: number;
  location: number;
  cleanliness: number;
  comment: string;
};

export type ListingVendor = {
  id: string;
  name: string;
  description: string;
  products: {
    name: string;
    price: number;
    currency: string;
    stock: number;
    description: string;
  }[];
};

export type ListingNeighbor = {
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    categories: string[];
    lat?: number;
    lng?: number;
  };
  place: { slug: string; name: string };
  island: { slug: string };
  geo?: { hostPlace: string; area?: string };
  distanceKm: number;
  href?: string;
};

export type ListingDiscovery = {
  origin: { lat: number; lng: number; address?: string } | null;
  sameAddress: ListingNeighbor[];
  similar: ListingNeighbor[];
  nearbyCategories: string[];
  nearby: ListingNeighbor[];
  activeCategory: string | null;
  radiusKm: number;
};

type ContactAction = {
  href: string;
  label: string;
  rel?: string;
  primary: boolean;
};

type Props = {
  locale: Locale;
  business: ListingBusiness;
  reviews: ListingReview[];
  vendor?: ListingVendor;
  placeName: string;
  islandLabel: string;
  portal: string;
  discovery: ListingDiscovery;
  nearbyWithHref: Array<ListingNeighbor & { href: string }>;
  nearbySeed: string;
  neighborHrefTemplate: string;
  discoveryApi: string;
  listingLocationMarkers: DirectoryMapMarker[];
  listingCopy: Record<string, string>;
  apiBase: string;
  neighborHref: (n: ListingNeighbor) => string;
  bookingToday: string;
};

const {
  locale,
  business,
  reviews,
  vendor,
  placeName,
  islandLabel,
  portal,
  discovery,
  nearbyWithHref,
  nearbySeed,
  neighborHrefTemplate,
  discoveryApi,
  listingLocationMarkers,
  listingCopy,
  apiBase,
  neighborHref,
  bookingToday,
} = Astro.props as Props;

const photos = (business.gallery ?? []).filter(Boolean);
const wa = whatsappHref(business.whatsapp);
const phoneLink = telHref(business.phone);
const directionsLink = mapsHref({
  address: business.address,
  lat: business.lat,
  lng: business.lng,
});
const siteLink = websiteHref(business.website);
const hoursLive = listingHoursStatus(business.openingHours);

const contactActions: ContactAction[] = [];
if (wa) {
  contactActions.push({
    href: wa,
    label: t(locale, "chatWhatsApp"),
    rel: "noopener noreferrer",
    primary: contactActions.length === 0,
  });
}
if (phoneLink) {
  contactActions.push({
    href: phoneLink,
    label: t(locale, "call"),
    primary: contactActions.length === 0,
  });
}
if (directionsLink) {
  contactActions.push({
    href: directionsLink,
    label: t(locale, "directions"),
    rel: "noopener noreferrer",
    primary: contactActions.length === 0,
  });
}

const moreActions: { href: string; label: string; rel?: string }[] = [];
if (siteLink) {
  moreActions.push({
    href: siteLink,
    label: t(locale, "website"),
    rel: "noopener noreferrer",
  });
}
if (business.bookingMode !== "none") {
  moreActions.push({ href: "#book", label: t(locale, "book") });
}
moreActions.push({
  href: `${portal}/claim?businessId=${business.id}`,
  label: t(locale, "claimThis"),
});

const categoryLine = business.categories
  .map((c) => categoryLabel(c, locale))
  .filter(Boolean)
  .join(" · ");
const locationLine = [placeName, islandLabel].filter(Boolean).join(", ");

let quietStatus: string | null = null;
let stamp: string | null = null;
if (business.sample) {
  quietStatus = t(locale, "sampleListing");
} else if (business.status === "claimed") {
  stamp = t(locale, "ownerVerified");
} else if (business.status === "published" || business.status === "draft") {
  quietStatus = t(locale, "listedUnclaimed");
}

const hoursLabel =
  hoursLive.open === true
    ? t(locale, "openNow")
    : hoursLive.open === false
      ? t(locale, "closedNow")
      : null;

function scoreLine(r: ListingReview) {
  return [
    `${t(locale, "scoreService")} ${r.service}/5`,
    `${t(locale, "scoreValue")} ${r.value}/5`,
    `${t(locale, "scoreLocation")} ${r.location}/5`,
    `${t(locale, "scoreCleanliness")} ${r.cleanliness}/5`,
  ].join(" · ");
}
---

<div class:list={["record-layout", { "has-dock": contactActions.length > 0 }]}>
  <article class="record listing-record">
  <div class:list={["listing-hero", { "has-gallery": photos.length > 0 }]}>
    {photos.length > 0 && (
      <div class="listing-gallery">
        {photos.map((src, i) => (
          <img
            src={src}
            alt={`${business.name} ${i + 1}`}
            width="800"
            height="600"
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        ))}
      </div>
    )}

    <div class="listing-copy">
      <header class="listing-identity">
        <h1>{business.name}</h1>
        <p class="listing-id-meta">
          {categoryLine && <span>{categoryLine}</span>}
          {categoryLine && locationLine && <span aria-hidden="true"> · </span>}
          {locationLine && <span>{locationLine}</span>}
          {stamp && (
            <>
              {(categoryLine || locationLine) && <span aria-hidden="true"> · </span>}
              <span class="stamp">{stamp}</span>
            </>
          )}
        </p>
        {quietStatus && <p class="listing-quiet">{quietStatus}</p>}
      </header>

      <p class="prose">{business.summary}</p>
    </div>
  </div>
  </article>

  <aside class="record-aside" aria-label={t(locale, "listingActions")}>
    {(contactActions.length > 0 || moreActions.length > 0) && (
      <p class="actions listing-actions">
        {contactActions.map((a) => (
          <a
            class:list={["cta", "listing-contact", { secondary: !a.primary }]}
            href={a.href}
            rel={a.rel}
          >
            {a.label}
          </a>
        ))}
        {moreActions.map((a) => (
          <a class="cta secondary" href={a.href} rel={a.rel}>
            {a.label}
          </a>
        ))}
      </p>
    )}
    {(business.address || listingLocationMarkers.length > 0) && (
      <section class="listing-place" aria-labelledby="listing-place-heading">
        <h2 id="listing-place-heading">{t(locale, "addressLabel")}</h2>
        {business.address && <p class="listing-address">{business.address}</p>}
        {business.phone && (
          <p class="meta">
            {t(locale, "phoneLabel")}:{" "}
            {phoneLink ? <a href={phoneLink}>{business.phone}</a> : business.phone}
          </p>
        )}
        {business.whatsapp && (
          <p class="meta">
            WhatsApp:{" "}
            {wa ? (
              <a href={wa} rel="noopener noreferrer">
                {business.whatsapp}
              </a>
            ) : (
              business.whatsapp
            )}
          </p>
        )}
        {business.verifiedAt && (
          <p class="meta">
            {t(locale, "lastVerified")}:{" "}
            {new Date(business.verifiedAt).toLocaleDateString(
              locale === "id" ? "id-ID" : "en-GB",
              { dateStyle: "medium" },
            )}
          </p>
        )}
        {listingLocationMarkers.length > 0 && (
          <DirectoryMap
            label={t(locale, "mapLocation")}
            markers={listingLocationMarkers}
            compact
          />
        )}
      </section>
    )}
  </aside>

  <div class="record-main stack">
    <section class="section">
      <h2>{t(locale, "overview")}</h2>
      <p class="prose">{business.description}</p>
    </section>

    {business.openingHours?.length > 0 && (
      <section class="section" aria-labelledby="hours-caption">
        <div class="table-wrap">
          <table class="data">
            <caption id="hours-caption">
              {t(locale, "openingHours")}
              {hoursLabel && (
                <span class:list={["hours-live", { open: hoursLive.open === true }]}>
                  {" "}
                  — {hoursLabel}
                </span>
              )}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t(locale, "day")}</th>
                <th scope="col">{t(locale, "hours")}</th>
              </tr>
            </thead>
            <tbody>
              {business.openingHours.map((h) => (
                <tr class:list={[{ "is-today": h.day === hoursLive.today }]}>
                  <th scope="row">{weekdayLabel(locale, h.day)}</th>
                  <td>{h.closed ? t(locale, "closed") : `${h.open} – ${h.close}`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {discovery.sameAddress.length > 0 && (
      <section class="section" aria-labelledby="same-address-heading">
        <h2 id="same-address-heading">{t(locale, "otherAtAddress")}</h2>
        <p class="meta">{business.address}</p>
        <ol class="index-list">
          {discovery.sameAddress.map((n, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={neighborHref(n)}>{n.business.name}</a>
                <span class="rhs">{categoryLabel(n.business.categories[0] ?? "", locale) || n.place.name}</span>
              </div>
              <p class="index-desc">{n.business.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {discovery.similar.length > 0 && (
      <section class="section" aria-labelledby="similar-heading">
        <h2 id="similar-heading">{t(locale, "similarNearby")}</h2>
        <ol class="index-list">
          {discovery.similar.map((n, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={neighborHref(n)}>{n.business.name}</a>
                <span class="rhs">
                  {n.distanceKm.toFixed(2)} {t(locale, "kmAway")} · {n.place.name}
                </span>
              </div>
              <p class="index-desc">{n.business.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {discovery.origin && (
      <section
        class="section nearby-discovery"
        aria-labelledby="nearby-cat-heading"
        data-nearby-root
        data-endpoint={discoveryApi}
        data-active-category={discovery.activeCategory ? encodeURIComponent(discovery.activeCategory) : ""}
        data-empty-label={t(locale, "noNearbyInCategory")}
        data-href-template={neighborHrefTemplate}
        data-initial={nearbySeed}
      >
        <h2 id="nearby-cat-heading">{t(locale, "nearbyByCategory")}</h2>
        <div
          class="category-chips"
          role="group"
          aria-label={t(locale, "category")}
        >
          {discovery.nearbyCategories.map((cat) => (
            <button
              type="button"
              class:list={["chip", { "is-active": cat === discovery.activeCategory }]}
              data-category={encodeURIComponent(cat)}
              aria-pressed={cat === discovery.activeCategory ? "true" : "false"}
            >
              {categoryLabel(cat, locale)}
            </button>
          ))}
        </div>
        <div class="nearby-layout">
          <div
            class="nearby-map"
            data-nearby-map
            hidden
            role="img"
            aria-label={t(locale, "nearbyMap")}
          ></div>
          <div data-nearby-list>
            {nearbyWithHref.length === 0 ? (
              <p class="meta">{t(locale, "noNearbyInCategory")}</p>
            ) : (
              <ol class="index-list">
                {nearbyWithHref.map((n, i) => (
                  <li>
                    <div class="index-row">
                      <span class="n">{String(i + 1).padStart(2, "0")}</span>
                      <a class="name" href={n.href}>{n.business.name}</a>
                      <span class="rhs">
                        {n.distanceKm.toFixed(2)} {t(locale, "kmAway")}
                      </span>
                    </div>
                    <p class="index-desc">{n.business.summary}</p>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      </section>
    )}

    {vendor && (
      <section class="section">
        <h2>{t(locale, "shop")} · {vendor.name}</h2>
        <p class="prose">{vendor.description}</p>
        <p class="meta">{t(locale, "shopNote")}</p>
        <ol class="index-list">
          {vendor.products.map((p, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <span class="name">{p.name}</span>
                <span class="rhs">
                  {p.price.toLocaleString("id-ID")} {p.currency} · {p.stock} {t(locale, "available")}
                </span>
              </div>
              <p class="index-desc">{p.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="section" id="reviews">
      <h2>{t(locale, "reviews")}</h2>
      {reviews.length === 0 && <p class="meta">{t(locale, "noReviews")}</p>}
      {reviews.length > 0 && (
        <ul class="review-list">
          {reviews.map((r) => (
            <li>
              <article class="review-card">
                <h3>{r.authorName}</h3>
                <p class="review-scores">{scoreLine(r)}</p>
                <p class="prose">{r.comment}</p>
              </article>
            </li>
          ))}
        </ul>
      )}

      <form class="stack" method="POST" id="review-form">
        <h3>{t(locale, "addReview")}</h3>
        <label>{t(locale, "reviewName")} <input name="authorName" required autocomplete="nickname" /></label>
        <label>{t(locale, "reviewComment")} <textarea name="comment" required rows="3"></textarea></label>
        <fieldset class="scores">
          <legend>{t(locale, "reviewScoresLegend")}</legend>
          <label>{t(locale, "scoreService")} <input type="number" name="service" min="1" max="5" value="5" required /></label>
          <label>{t(locale, "scoreValue")} <input type="number" name="value" min="1" max="5" value="5" required /></label>
          <label>{t(locale, "scoreLocation")} <input type="number" name="location" min="1" max="5" value="5" required /></label>
          <label>
            {t(locale, "scoreCleanliness")}
            <input type="number" name="cleanliness" min="1" max="5" value="5" required />
          </label>
        </fieldset>
        <button type="submit">{t(locale, "reviewSubmit")}</button>
        <p class="meta" id="review-msg" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="section" id="report">
      <h2>{t(locale, "suggestCorrection")}</h2>
      <form class="stack" id="report-form">
        <label>
          {t(locale, "reportNote")}
          <textarea name="note" required minlength="12" rows="3"></textarea>
        </label>
        <label>
          {t(locale, "reportKind")}
          <select name="kind">
            <option value="correction">{t(locale, "reportCorrection")}</option>
            <option value="abuse">{t(locale, "reportAbuseKind")}</option>
          </select>
        </label>
        <button type="submit">{t(locale, "reportSend")}</button>
        <p class="meta" id="report-msg" role="status" aria-live="polite"></p>
      </form>
    </section>

    {business.bookingMode !== "none" && (
      <section class="section" id="book">
        <h2>{t(locale, "bookingTitle")}</h2>
        <p class="meta" id="booking-notice">
          {t(locale, "bookingNotice")}
        </p>
        <form
          class="stack"
          id="booking-form"
          aria-describedby="booking-notice"
        >
          <label>{t(locale, "customerName")} <input name="customerName" required autocomplete="name" /></label>
          <label>{t(locale, "customerEmail")} <input type="email" name="customerEmail" required autocomplete="email" /></label>
          <label>{t(locale, "bookingDate")} <input type="date" name="startDate" required min={bookingToday} /></label>
          {business.bookingMode === "service" && (
            <label>{t(locale, "timeSlot")} <input name="timeSlot" placeholder="10:00" /></label>
          )}
          {business.bookingMode === "rental" && (
            <label>{t(locale, "endDate")} <input type="date" name="endDate" required min={bookingToday} /></label>
          )}
          {business.bookingMode === "event" && (
            <label>{t(locale, "tickets")} <input type="number" name="tickets" min="1" value="1" required /></label>
          )}
          <button type="submit">{t(locale, "bookingSubmit")}</button>
          <p class="meta" id="booking-msg" role="status" aria-live="polite"></p>
        </form>
      </section>
    )}
  </div>
</div>

{contactActions.length > 0 && (
  <nav class="listing-action-bar" aria-label={t(locale, "listingActions")}>
    {contactActions.map((a) => (
      <a
        class:list={["cta", { secondary: !a.primary }]}
        href={a.href}
        rel={a.rel}
      >
        {a.label}
      </a>
    ))}
  </nav>
)}

<script define:vars={{ apiBase, businessId: business.id, listingCopy }}>
  const L = typeof listingCopy === "undefined" ? {} : listingCopy;
  function txt(key, fallback) {
    return L[key] || fallback;
  }
  function withN(key, fallback, n) {
    return txt(key, fallback).replace("{n}", String(n ?? ""));
  }
  const errorCodes = {
    BOOKING_PAST_DATE: ["bookingPastDate", "Date must be today or later."],
    BOOKING_NEED_END_DATE: ["bookingNeedEndDate", "Rentals need an end date."],
    BOOKING_NEED_TICKETS: ["bookingNeedTickets", "Events need a ticket count."],
    BOOKING_END_BEFORE_START: [
      "bookingEndBeforeStart",
      "End date must be on or after the start date.",
    ],
    BOOKING_DUPLICATE: [
      "bookingDuplicate",
      "A pending request already exists for these dates.",
    ],
    BOOKING_NOT_ENABLED: ["bookingDisabled", "Booking is not available for this listing."],
  };
  function visitorError(kind, status, data) {
    const mapped = data && data.code ? errorCodes[data.code] : null;
    if (mapped) return txt(mapped[0], mapped[1]);
    if (kind === "booking") {
      if (status === 409) {
        return txt("bookingDuplicate", "A pending request already exists for these dates.");
      }
      return txt("bookingRejected", "Request could not be sent. Check the dates and try again.");
    }
    if (kind === "review") return txt("reviewFailed", "Review could not be sent. Try again.");
    if (kind === "report") return txt("reportFailed", "Report could not be sent. Try again.");
    return txt("requestFailed", "Could not send. Try again.");
  }
  function setStatus(el, text, isError) {
    if (!el) return;
    el.textContent = text;
    el.classList.toggle("error", !!isError);
    const form = el.closest("form");
    if (form) {
      if (isError) form.setAttribute("aria-invalid", "true");
      else form.removeAttribute("aria-invalid");
    }
  }

  function lockForm(form, locked) {
    form.querySelectorAll("button, input, textarea, select").forEach((node) => {
      node.disabled = locked;
    });
  }

  const reviewForm = document.getElementById("review-form");
  const reviewMsg = document.getElementById("review-msg");
  reviewForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (reviewForm.dataset.busy === "1") return;
    const fd = new FormData(reviewForm);
    reviewForm.dataset.busy = "1";
    lockForm(reviewForm, true);
    setStatus(reviewMsg, txt("reviewSubmitting", "Submitting review…"), false);
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/reviews`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          authorName: fd.get("authorName"),
          comment: fd.get("comment"),
          service: Number(fd.get("service")),
          value: Number(fd.get("value")),
          location: Number(fd.get("location")),
          cleanliness: Number(fd.get("cleanliness")),
        }),
      });
      if (res.ok) {
        location.reload();
        return;
      }
      let data = {};
      try {
        data = await res.json();
      } catch {}
      let detail = visitorError("review", res.status, data);
      if (res.status === 429) {
        const ra = res.headers.get("Retry-After");
        detail = ra
          ? withN("reviewTooManyRetry", "Too many reviews — retry in {n}s.", ra)
          : txt("reviewTooMany", "Too many reviews — try later.");
      }
      setStatus(reviewMsg, detail, true);
    } catch {
      setStatus(reviewMsg, txt("networkRetry", "Network error — check your connection and try again."), true);
    } finally {
      reviewForm.dataset.busy = "0";
      lockForm(reviewForm, false);
    }
  });

  const bookingForm = document.getElementById("booking-form");
  const bookingMsg = document.getElementById("booking-msg");
  let bookingIdempotencyKey = crypto.randomUUID();
  let lastBookingPayload;
  bookingForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (bookingForm.dataset.busy === "1") return;
    // Disabled controls are omitted by FormData, so capture values before locking.
    const fd = new FormData(bookingForm);
    bookingForm.dataset.busy = "1";
    lockForm(bookingForm, true);
    setStatus(bookingMsg, txt("bookingSending", "Sending request…"), false);
    const payload = {
      customerName: fd.get("customerName"),
      customerEmail: fd.get("customerEmail"),
      startDate: fd.get("startDate"),
      endDate: fd.get("endDate") || undefined,
      timeSlot: fd.get("timeSlot") || undefined,
      tickets: fd.get("tickets") ? Number(fd.get("tickets")) : undefined,
    };
    const serializedPayload = JSON.stringify(payload);
    if (lastBookingPayload !== undefined && lastBookingPayload !== serializedPayload) {
      bookingIdempotencyKey = crypto.randomUUID();
    }
    lastBookingPayload = serializedPayload;
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/bookings`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "idempotency-key": bookingIdempotencyKey,
        },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        setStatus(
          bookingMsg,
          txt("bookingPendingOk", "Request recorded as pending. This is not a confirmed reservation."),
          false,
        );
        bookingForm.reset();
        bookingIdempotencyKey = crypto.randomUUID();
      } else {
        let data = {};
        try {
          data = await res.json();
        } catch {}
        let detail = visitorError("booking", res.status, data);
        if (res.status === 429) {
          const ra = res.headers.get("Retry-After");
          detail = ra
            ? withN("tooManyRetryKept", "Too many requests — retry in {n}s. Your form was kept.", ra)
            : txt("tooManyKept", "Too many requests — try later. Your form was kept.");
        }
        setStatus(bookingMsg, detail, true);
      }
    } catch {
      setStatus(
        bookingMsg,
        txt("networkKept", "Network error — your details were kept. Try again."),
        true,
      );
    } finally {
      bookingForm.dataset.busy = "0";
      lockForm(bookingForm, false);
    }
  });

  const reportForm = document.getElementById("report-form");
  const reportMsg = document.getElementById("report-msg");
  reportForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (reportForm.dataset.busy === "1") return;
    const fd = new FormData(reportForm);
    reportForm.dataset.busy = "1";
    lockForm(reportForm, true);
    setStatus(reportMsg, txt("reportSending", "Sending report…"), false);
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/reports`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          kind: fd.get("kind") || "correction",
          note: fd.get("note"),
        }),
      });
      if (res.ok) {
        setStatus(reportMsg, txt("reportReceived", "Report received. Operators will review it."), false);
        reportForm.reset();
      } else {
        let data = {};
        try {
          data = await res.json();
        } catch {}
        setStatus(reportMsg, visitorError("report", res.status, data), true);
      }
    } catch {
      setStatus(reportMsg, txt("reportNetwork", "Network error — your note was kept. Try again."), true);
    } finally {
      reportForm.dataset.busy = "0";
      lockForm(reportForm, false);
    }
  });
  // Written by apps/web/scripts/copy-vendor.mjs into public/vendor/.
  const leafletJs = "/vendor/leaflet/leaflet.js";
  const leafletCss = "/vendor/leaflet/leaflet.css";

  // —— Nearby discovery ————————————————————————————————————————————
  // The list is server-rendered; this only adds category switching and the
  // map. Leaflet (~148 KB) is fetched from our own origin the first time the
  // map is about to come into view, so readers who never scroll there — the
  // 3G phone case the performance budget is written for — never pay for it.
  const nearbyRoot = document.querySelector("[data-nearby-root]");
  if (nearbyRoot) initNearby(nearbyRoot);

  function initNearby(root) {
    const endpoint = root.dataset.endpoint;
    const emptyLabel = root.dataset.emptyLabel || "";
    const listEl = root.querySelector("[data-nearby-list]");
    const mapEl = root.querySelector("[data-nearby-map]");
    const chips = Array.from(root.querySelectorAll("[data-category]"));
    if (!endpoint || !listEl || !mapEl) return;

    const hrefTemplate = root.dataset.hrefTemplate || "";
    let map = null;
    let layer = null;
    let seq = 0;

    // Seeded from the server so the map agrees with the rendered list the
    // moment it opens, without spending a request to re-fetch what is
    // already on the page.
    let latest = { origin: null, items: [] };
    try {
      const seed = JSON.parse(root.dataset.initial || "null");
      if (seed) latest = { origin: seed.origin, items: seed.nearby || [] };
    } catch {
      // Keep the empty default; the map simply opens without markers.
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // Substituted into the template tenantHref produced for this request, so
    // refetched links keep the locale prefix and the canonical tenant host.
    // One pass: chained replaces would re-scan text they had just inserted,
    // so a slug that happens to read "x-slug-x" could rewrite the hostname.
    function hrefFor(n) {
      const geo = n.geo || {};
      const area = geo.area || "";
      let href = hrefTemplate;
      if (area) {
        href = href.replaceAll("x-area-x", area);
      } else {
        href = href.replace("/x-area-x", "");
      }
      const values = {
        "x-place-x": geo.hostPlace || n.place.slug,
        "x-island-x": n.island.slug,
        "x-slug-x": n.business.slug,
      };
      return href.replace(
        /x-(?:place|island|slug)-x/g,
        (token) => values[token],
      );
    }

    function renderList(items) {
      if (items.length === 0) {
        listEl.innerHTML = `<p class="meta">${escapeHtml(emptyLabel)}</p>`;
        return;
      }
      const ol = document.createElement("ol");
      ol.className = "index-list";
      items.forEach((n, i) => {
        const li = document.createElement("li");
        li.innerHTML = `
      <div class="index-row">
        <span class="n">${String(i + 1).padStart(2, "0")}</span>
        <a class="name" href="${escapeHtml(hrefFor(n))}">${escapeHtml(n.business.name)}</a>
        <span class="rhs">${n.distanceKm.toFixed(2)} ${txt("kmAway", "km")}</span>
      </div>
      <p class="index-desc">${escapeHtml(n.business.summary)}</p>`;
        ol.appendChild(li);
      });
      listEl.replaceChildren(ol);
    }

    function syncMap() {
      if (!map || !layer) return;
      const L = window.L;
      layer.clearLayers();
      const bounds = [];
      if (latest.origin) {
        layer.addLayer(
          L.circleMarker([latest.origin.lat, latest.origin.lng], {
            radius: 7,
            color: "#1a1c22",
            fillColor: "#1a1c22",
            fillOpacity: 1,
            weight: 1,
          }).bindPopup(txt("mapHere", "Here")),
        );
        bounds.push([latest.origin.lat, latest.origin.lng]);
      }
      latest.items.forEach((n, i) => {
        if (typeof n.business.lat !== "number" || typeof n.business.lng !== "number") {
          return;
        }
        layer.addLayer(
          L.circleMarker([n.business.lat, n.business.lng], {
            radius: 6,
            color: "#1a29c4",
            fillColor: "#1a29c4",
            fillOpacity: 0.85,
            weight: 1,
          }).bindPopup(
            `<strong>${String(i + 1).padStart(2, "0")}. ${escapeHtml(n.business.name)}</strong><br>${n.distanceKm.toFixed(2)} ${txt("kmAway", "km")}`,
          ),
        );
        bounds.push([n.business.lat, n.business.lng]);
      });
      if (bounds.length > 0) {
        map.fitBounds(L.latLngBounds(bounds), { padding: [24, 24], maxZoom: 15 });
      }
      map.invalidateSize();
    }

    let mapReady = null;
    function loadMap() {
      if (mapReady) return mapReady;
      mapReady = new Promise((resolve, reject) => {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = leafletCss;
        document.head.appendChild(link);
        const tag = document.createElement("script");
        tag.src = leafletJs;
        tag.onload = () => resolve(window.L);
        tag.onerror = () => reject(new Error("leaflet failed to load"));
        document.head.appendChild(tag);
      })
        .then((L) => {
          mapEl.hidden = false;
          map = L.map(mapEl, { scrollWheelZoom: false, attributionControl: true });
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);
          layer = L.layerGroup().addTo(map);
          map.setView([-8.54, 115.32], 13);
          // Leaflet measures its pane after layout.
          requestAnimationFrame(() => {
            map.invalidateSize();
            syncMap();
          });
        })
        .catch(() => {
          // No map is fine — the list above it is the real content.
          mapEl.hidden = true;
        });
      return mapReady;
    }

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            void loadMap();
          }
        },
        { rootMargin: "200px" },
      );
      io.observe(root);
    } else {
      void loadMap();
    }

    async function load(category) {
      const mine = ++seq;
      const url = new URL(endpoint);
      if (category) url.searchParams.set("category", category);
      else url.searchParams.delete("category");
      let data;
      try {
        const res = await fetch(url.toString());
        if (!res.ok || mine !== seq) return;
        data = await res.json();
      } catch {
        return;
      }
      if (mine !== seq) return;
      chips.forEach((btn) => {
        const cat = decodeURIComponent(btn.dataset.category || "");
        const active = cat === (data.activeCategory ?? "");
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.classList.toggle("is-active", active);
      });
      latest = { origin: data.origin, items: data.nearby };
      renderList(latest.items);
      syncMap();
    }

    chips.forEach((btn) => {
      btn.addEventListener("click", () => {
        const raw = btn.dataset.category || "";
        void load(raw ? decodeURIComponent(raw) : null);
      });
    });
  }
</script>

