---
import { t, type Locale } from "../i18n/ui";
import { HERO_CATEGORIES, heroCategoryHref } from "../lib/hero-categories";

type Props = {
  locale: Locale;
  island?: string;
  place?: string;
  area?: string;
};

const { locale, island, place, area } = Astro.props as Props;
const req = Astro.request;
---

<nav class="section cat-shortcuts" aria-label={t(locale, "catShortcuts")}>
  <p class="meta">{t(locale, "catShortcuts")}</p>
  <p class="actions">
    {HERO_CATEGORIES.map((cat) => (
      <a
        href={heroCategoryHref(req, {
          locale,
          slug: cat.slug,
          island,
          place,
          area,
        })}
      >
        {t(locale, cat.key)}
      </a>
    ))}
  </p>
</nav>
<style>
  .cat-shortcuts .actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .75rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }
  .cat-shortcuts .actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); gap: .5rem 1.5rem; }
  .cat-shortcuts a::after { content: "→"; color: var(--link); }
  .cat-shortcuts .actions a:hover { color: var(--link); text-decoration: underline; }
</style>
