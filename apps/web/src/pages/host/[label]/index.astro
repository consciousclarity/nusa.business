---
import Base from "../../../layouts/Base.astro";
import { api } from "../../../lib/api";
import { tenantHref } from "../../../lib/links";

const label = Astro.params.label!;
const parts = label.split(".");
const req = Astro.request;

type IslandPayload = {
  island: { slug: string; name: string; tagline: string; status?: string };
  places: { id: string; slug: string; name: string; summary: string; type: string }[];
  businesses: {
    id: string;
    placeId: string;
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
  }[];
};

type PlacePayload = {
  island: { slug: string; name: string };
  place: { slug: string; name: string; summary: string; type: string };
  businesses: {
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
    registeredByAgentId?: string;
  }[];
};

let mode: "island" | "place" | "none" = "none";
let islandData: IslandPayload | null = null;
let placeData: PlacePayload | null = null;

if (parts.length === 1) {
  mode = "island";
  islandData = await api<IslandPayload>(`/v1/islands/${parts[0]}`);
} else if (parts.length === 2) {
  mode = "place";
  placeData = await api<PlacePayload>(
    `/v1/islands/${parts[1]}/places/${parts[0]}`,
  );
} else {
  return Astro.redirect("/");
}

const placeById = islandData
  ? Object.fromEntries(islandData.places.map((p) => [p.id, p]))
  : {};
const recent =
  placeData?.businesses.filter((b) => b.registeredByAgentId).slice(0, 5) ?? [];

const queryHost =
  mode === "island" && islandData
    ? `${islandData.island.slug}.nusa.business`
    : mode === "place" && placeData
      ? `${placeData.place.slug}.${placeData.island.slug}.nusa.business`
      : label;
---

{mode === "island" && islandData && (
  <Base
    title={`${islandData.island.name} — nusa.business`}
    description={islandData.island.tagline}
    crumb={[{ label: islandData.island.slug }]}
  >
    <section class="lede">
      <h1>{islandData.island.name}</h1>
      <p class="prose">{islandData.island.tagline}</p>
    </section>

    <aside class="resolver" aria-label="Host resolver">
      <dl>
        <dt>Query</dt>
        <dd>{queryHost}</dd>
        <dt>Resolved</dt>
        <dd>island={islandData.island.slug}</dd>
        <dt>Records</dt>
        <dd>
          {islandData.places.length} places · {islandData.businesses.length} listings
        </dd>
      </dl>
    </aside>

    <section class="section">
      <h2>Places</h2>
      <ol class="index-list">
        {islandData.places.map((place, i) => (
          <li>
            <div class="index-row">
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <a
                class="name"
                href={tenantHref(req, {
                  island: islandData!.island.slug,
                  place: place.slug,
                })}
              >
                {place.name}
              </a>
              <span class="rhs">{place.type.replaceAll("_", " ")}</span>
            </div>
            <p class="index-desc">{place.summary}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section">
      <h2>Featured listings</h2>
      <ol class="index-list">
        {islandData.businesses.slice(0, 9).map((b, i) => {
          const place = placeById[b.placeId];
          return (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a
                  class="name"
                  href={
                    place
                      ? tenantHref(req, {
                          island: islandData!.island.slug,
                          place: place.slug,
                          slug: b.slug,
                        })
                      : "#"
                  }
                >
                  {b.name}
                </a>
                <span class="rhs">{place?.name ?? ""}</span>
              </div>
              <p class="index-desc">{b.summary}</p>
            </li>
          );
        })}
      </ol>
    </section>
  </Base>
)}

{mode === "place" && placeData && (
  <Base
    title={`${placeData.place.name}, ${placeData.island.name} — nusa.business`}
    description={placeData.place.summary}
    crumb={[
      {
        label: placeData.island.slug,
        href: tenantHref(req, { island: placeData.island.slug }),
      },
      { label: placeData.place.slug },
    ]}
  >
    <section class="lede">
      <h1>{placeData.place.name}</h1>
      <p class="prose">{placeData.place.summary}</p>
    </section>

    <aside class="resolver" aria-label="Host resolver">
      <dl>
        <dt>Query</dt>
        <dd>{queryHost}</dd>
        <dt>Resolved</dt>
        <dd>
          island={placeData.island.slug} · place={placeData.place.slug} · type=
          {placeData.place.type}
        </dd>
        <dt>Records</dt>
        <dd>{placeData.businesses.length} published</dd>
      </dl>
    </aside>

    {recent.length > 0 && (
      <div class="banner">
        Just registered by field team: {recent.map((b) => b.name).join(" · ")}
      </div>
    )}

    <section class="section">
      <h2>Businesses in {placeData.place.name}</h2>
      <ol class="index-list">
        {placeData.businesses.map((b, i) => (
          <li>
            <div class="index-row">
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <a
                class="name"
                href={tenantHref(req, {
                  island: placeData!.island.slug,
                  place: placeData!.place.slug,
                  slug: b.slug,
                })}
              >
                {b.name}
              </a>
              <span class="rhs">
                {b.status === "draft" ? (
                  <span class="stamp">Unclaimed</span>
                ) : (
                  b.categories[0] ?? ""
                )}
              </span>
            </div>
            <p class="index-desc">{b.summary}</p>
          </li>
        ))}
      </ol>
    </section>
  </Base>
)}
