---
import Base from "../../../layouts/Base.astro";
import PlaceDirectory from "../../../components/PlaceDirectory.astro";
import { apiOrNull } from "../../../lib/api";
import { geoHref, tenantHref, tenantAbsHref, nationAbsHref } from "../../../lib/links";
import {
  breadcrumbJsonLd,
  hostPath,
  websiteJsonLd,
} from "../../../lib/seo";
import { islandName, islandTagline, t, withLocale, placeTypeLabel, type Locale } from "../../../i18n/ui";
import { geoNesting, publicHostLine, type NestablePlace, canonicalizeCategory, TAXONOMY, categoryLabel } from "@nusa/shared";

const label = Astro.params.label!;
const parts = label.split(".");
const req = Astro.request;
const locale: Locale = Astro.locals.locale ?? "en";
const categoryParam = (Astro.url.searchParams.get("category") || "").trim();

type HubPlace = NestablePlace & { name: string; summary: string };

type IslandPayload = {
  island: {
    slug: string;
    name: string;
    tagline: string;
    status?: string;
    kind?: string;
    region?: string;
  };
  places: HubPlace[];
  childProvinces?: { slug: string; name: string; tagline: string }[];
  businesses: {
    id: string;
    placeId: string;
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
    sample?: boolean;
  }[];
};

type PlacePayload = {
  island: { slug: string; name: string };
  place: HubPlace;
  parent?: HubPlace | null;
  children?: HubPlace[];
  businesses: {
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
    sample?: boolean;
    fieldRegistered?: boolean;
  }[];
};

let mode: "island" | "place" | "none" = "none";
let islandData: IslandPayload | null = null;
let placeData: PlacePayload | null = null;

if (parts.length === 1) {
  mode = "island";
  islandData = await apiOrNull<IslandPayload>(`/v1/islands/${parts[0]}`);
} else if (parts.length === 2) {
  mode = "place";
  placeData = await apiOrNull<PlacePayload>(
    `/v1/islands/${parts[1]}/places/${parts[0]}`,
  );
} else {
  return Astro.redirect(withLocale("/", locale));
}

if ((mode === "island" && !islandData) || (mode === "place" && !placeData)) {
  return Astro.rewrite(withLocale("/404", locale));
}

if (mode === "island" && islandData && parts[0] !== islandData.island.slug) {
  return Astro.redirect(
    withLocale(hostPath({ island: islandData.island.slug }), locale),
    301,
  );
}

if (mode === "place" && placeData && parts[1] !== placeData.island.slug) {
  return Astro.redirect(
    withLocale(
      hostPath({
        island: placeData.island.slug,
        place: placeData.place.slug,
      }),
      locale,
    ),
    301,
  );
}

const islandHubLabel = islandData
  ? islandName(locale, islandData.island.slug, islandData.island.name)
  : "";
const placeIslandLabel = placeData
  ? islandName(locale, placeData.island.slug, placeData.island.name)
  : "";

if (placeData) {
  const byId: Record<string, HubPlace> = {
    [placeData.place.id]: placeData.place,
  };
  if (placeData.parent) byId[placeData.parent.id] = placeData.parent;
  const nest = geoNesting(placeData.place, byId);
  if (nest.area) {
    return Astro.redirect(
      withLocale(
        hostPath({
          island: placeData.island.slug,
          place: nest.hostPlace,
          area: nest.area,
        }),
        locale,
      ),
      301,
    );
  }
}

if (categoryParam) {
  const slug = canonicalizeCategory(categoryParam);
  if (slug) {
    if (placeData) {
      return Astro.redirect(
        withLocale(
          hostPath({
            island: placeData.island.slug,
            place: placeData.place.slug,
            category: slug,
          }),
          locale,
        ),
        301,
      );
    }
    if (islandData) {
      return Astro.redirect(
        withLocale(
          hostPath({ island: islandData.island.slug, category: slug }),
          locale,
        ),
        301,
      );
    }
  }
}

const placeById = islandData
  ? Object.fromEntries(islandData.places.map((p) => [p.id, p]))
  : {};

const queryHost =
  mode === "island" && islandData
    ? `${islandData.island.slug}.nusa.business`
    : mode === "place" && placeData
      ? publicHostLine({
          island: placeData.island.slug,
          place: placeData.place.slug,
        })
      : label;

const islandCanonical =
  islandData &&
  tenantAbsHref(req, { island: islandData.island.slug, locale });
const placeCanonical =
  placeData &&
  tenantAbsHref(req, {
    island: placeData.island.slug,
    place: placeData.place.slug,
    locale,
  });
---

{mode === "island" && islandData && (
  <Base
    title={`${islandHubLabel} — nusa.business`}
    description={islandTagline(locale, islandData.island.slug, islandData.island.tagline)}
    crumb={[{ label: islandHubLabel }]}
    locale={locale}
    canonical={islandCanonical!}
    jsonLd={[
      websiteJsonLd({
        locale,
        url: islandCanonical!,
        name: `${islandHubLabel} — nusa.business`,
        description: islandTagline(locale, islandData.island.slug, islandData.island.tagline),
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: nationAbsHref(req, locale) },
        { name: islandHubLabel, url: islandCanonical! },
      ]),
    ]}
  >
    <section class="lede">
      <h1>{islandHubLabel}</h1>
      <p class="prose">{islandTagline(locale, islandData.island.slug, islandData.island.tagline)}</p>
    </section>

    {islandData.island.status === "coming_soon" && (
      <p class="banner">
        {t(locale, "comingSoonNext")}{" "}
        <a href={tenantHref(req, { island: "bali", locale })}>
          {t(locale, "browseBali")}
        </a>
      </p>
    )}

    <form
      class="section filter-bar"
      method="get"
      action={withLocale("/search", locale)}
    >
      <input type="hidden" name="island" value={islandData.island.slug} />
      <label>
        {t(locale, "findBusiness")}
        <input
          type="search"
          name="q"
          placeholder={t(locale, "searchPlaceholder")}
          autocomplete="off"
          maxlength="120"
        />
      </label>
      <label>
        {t(locale, "category")}
        <select name="category">
          <option value="">{t(locale, "allCategories")}</option>
          {TAXONOMY.map((group) => (
            <option value={group.slug}>{categoryLabel(group.slug, locale)}</option>
          ))}
        </select>
      </label>
      <button type="submit">{t(locale, "search")}</button>
    </form>

    <section class="section">
      <h2>
        {islandData.island.kind === "region"
          ? t(locale, "provinces")
          : t(locale, "regenciesCities")}
      </h2>
      <ol class="index-list">
        {(islandData.island.kind === "region"
          ? (islandData.childProvinces ?? []).map((p) => ({
              slug: p.slug,
              name: p.name,
              summary: p.tagline,
              type: "province",
              id: p.slug,
            }))
          : islandData.places.filter(
              (p) => p.type === "kabupaten" || p.type === "kota",
            )
        ).map((place, i) => {
          const parent =
            "parentPlaceId" in place && place.parentPlaceId
              ? placeById[place.parentPlaceId as string]
              : undefined;
          const href =
            islandData!.island.kind === "region"
              ? tenantHref(req, { island: place.slug, locale })
              : geoHref(req, {
                  island: islandData!.island.slug,
                  place: place as HubPlace,
                  places: islandData!.places,
                  locale,
                });
          return (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={href}>
                  {place.name}
                </a>
                <span class="rhs">
                  {islandData!.island.kind === "region"
                    ? t(locale, "province")
                    : placeTypeLabel(locale, (place as HubPlace).type)}
                  {parent ? ` · ${parent.name}` : ""}
                </span>
              </div>
              <p class="index-desc">{place.summary}</p>
            </li>
          );
        })}
      </ol>
    </section>

    {islandData.island.kind !== "region" &&
      islandData.places.some((p) => p.type === "tourist_area") && (
        <section class="section">
          <h2>{t(locale, "areasIn")}</h2>
          <ol class="index-list">
            {islandData.places
              .filter((p) => p.type === "tourist_area")
              .map((place, i) => {
                const parent = place.parentPlaceId
                  ? placeById[place.parentPlaceId]
                  : undefined;
                return (
                  <li>
                    <div class="index-row">
                      <span class="n">{String(i + 1).padStart(2, "0")}</span>
                      <a
                        class="name"
                        href={geoHref(req, {
                          island: islandData!.island.slug,
                          place,
                          places: islandData!.places,
                          locale,
                        })}
                      >
                        {place.name}
                      </a>
                      <span class="rhs">
                        {placeTypeLabel(locale, place.type)}
                        {parent ? ` · ${parent.name}` : ""}
                      </span>
                    </div>
                    <p class="index-desc">{place.summary}</p>
                  </li>
                );
              })}
          </ol>
        </section>
      )}

    <section class="section">
      <h2>{t(locale, "featured")}</h2>
      <ol class="index-list">
        {islandData.businesses.slice(0, 9).map((b, i) => {
          const place = placeById[b.placeId];
          return (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a
                  class="name"
                  href={
                    place
                      ? geoHref(req, {
                          island: islandData!.island.slug,
                          place,
                          places: islandData!.places,
                          slug: b.slug,
                          locale,
                        })
                      : "#"
                  }
                >
                  {b.name}
                </a>
                <span class="rhs">
                  {b.sample ? (
                    <span class="stamp">{t(locale, "sampleListing")}</span>
                  ) : (
                    place?.name ?? ""
                  )}
                </span>
              </div>
              <p class="index-desc">{b.summary}</p>
            </li>
          );
        })}
      </ol>
    </section>
  </Base>
)}

{mode === "place" && placeData && (
  <Base
    title={`${placeData.place.name}, ${placeIslandLabel} — nusa.business`}
    description={placeData.place.summary}
    crumb={[
      {
        label: placeIslandLabel,
        href: tenantHref(req, { island: placeData.island.slug, locale }),
      },
      { label: placeData.place.name },
    ]}
    locale={locale}
    canonical={placeCanonical!}
    jsonLd={[
      websiteJsonLd({
        locale,
        url: placeCanonical!,
        name: `${placeData.place.name}, ${placeIslandLabel}`,
        description: placeData.place.summary,
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: nationAbsHref(req, locale) },
        {
          name: placeIslandLabel,
          url: tenantAbsHref(req, {
            island: placeData.island.slug,
            locale,
          }),
        },
        { name: placeData.place.name, url: placeCanonical! },
      ]),
    ]}
  >
    <PlaceDirectory
      island={placeData.island}
      place={placeData.place}
      parent={placeData.parent}
      children={placeData.children ?? []}
      businesses={placeData.businesses}
      queryHost={queryHost}
      locale={locale}
      categoryParam={categoryParam}
    />
  </Base>
)}
