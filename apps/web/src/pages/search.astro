---
import Base from "../layouts/Base.astro";
import DirectoryMap from "../components/DirectoryMap.astro";
import DirectoryNotice from "../components/DirectoryNotice.astro";
import { apiTry } from "../lib/api";
import { tenantHref } from "../lib/links";
import { listingMarker, takeMarkers } from "../lib/map-markers";
import { absoluteUrl } from "../lib/seo";
import { islandName, t, withLocale, type Locale } from "../i18n/ui";
import { categoryLabel, TAXONOMY } from "@nusa/shared";

const locale: Locale = Astro.locals.locale ?? "en";
const q = (Astro.url.searchParams.get("q") || "").trim();
const island = (Astro.url.searchParams.get("island") || "").trim();
const category = (Astro.url.searchParams.get("category") || "").trim();

const islands = await apiTry<{
  islands: { slug: string; name: string; status: string }[];
}>("/v1/islands");
const active = (islands?.islands ?? []).filter((i) => i.status === "active");

const params = new URLSearchParams();
if (q) params.set("q", q);
if (island) params.set("island", island);
if (category) params.set("category", category);

type Hit = {
  business: {
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    sample?: boolean;
    lat?: number;
    lng?: number;
  };
  place?: { name: string };
  island?: { slug: string; name: string };
  geo?: { hostPlace: string; area?: string };
};

const queried = Boolean(params.toString());
const search = queried
  ? await apiTry<{ results: Hit[] }>(`/v1/search?${params.toString()}`)
  : { results: [] as Hit[] };
const searchFailed = islands === null || (queried && search === null);
const hits = search?.results.slice(0, 50) ?? [];
const selectedIslandName = island
  ? islandName(
      locale,
      island,
      active.find((row) => row.slug === island)?.name ?? island,
    )
  : "";
const searchPath = withLocale("/search", locale) + (params.toString() ? `?${params}` : "");
const canonical = absoluteUrl(Astro.request, searchPath);
const title = q
  ? `${t(locale, "searchH1")}: ${q}`
  : t(locale, "searchTitle");

function hitHref(hit: Hit): string {
  return hit.island && hit.geo
    ? tenantHref(Astro.request, {
        island: hit.island.slug,
        place: hit.geo.hostPlace,
        area: hit.geo.area,
        slug: hit.business.slug,
        locale,
      })
    : "#";
}

const searchMarkers = takeMarkers(
  hits.map((hit) =>
    listingMarker({
      lat: hit.business.lat,
      lng: hit.business.lng,
      name: hit.business.name,
      href: hitHref(hit),
    }),
  ),
);
---
<Base
  title={title}
  description={t(locale, "searchLede")}
  canonical={canonical}
  locale={locale}
  robots="noindex,follow"
>
  <section class="lede">
    <h1>{t(locale, "searchH1")}</h1>
    <p class="prose">{t(locale, "searchLede")}</p>
  </section>

  <form class="section filter-bar" method="get" action={withLocale("/search", locale)}>
    <label>
      {t(locale, "findBusiness")}
      <input
        type="search"
        name="q"
        value={q}
        placeholder={t(locale, "searchPlaceholder")}
        autocomplete="off"
        maxlength="120"
      />
    </label>
    <label>
      {t(locale, "island")}
      <select name="island">
        <option value="">{t(locale, "allIslands")}</option>
        {active.map((row) => (
          <option value={row.slug} selected={row.slug === island}>
            {islandName(locale, row.slug, row.name)}
          </option>
        ))}
      </select>
    </label>
    <label>
      {t(locale, "category")}
      <select name="category">
        <option value="">{t(locale, "allCategories")}</option>
        {TAXONOMY.map((group) => (
          <option value={group.slug} selected={group.slug === category}>
            {categoryLabel(group.slug, locale)}
          </option>
        ))}
      </select>
    </label>
    <button type="submit">{t(locale, "search")}</button>
  </form>

  <section class="section">
    {searchFailed ? (
      <DirectoryNotice locale={locale} variant="unavailable" />
    ) : (
      <>
    <h2>
      {hits.length} {t(locale, "resultsIn")}
      {q ? ` · ${q}` : ""}
      {selectedIslandName ? ` · ${selectedIslandName}` : ""}
      {category ? ` · ${categoryLabel(category, locale)}` : ""}
    </h2>
    {hits.length === 0 ? (
      <DirectoryNotice locale={locale} variant="empty" />
    ) : (
      <>
      <DirectoryMap label={t(locale, "directoryMap")} markers={searchMarkers} />
      <ol class="index-list">
        {hits.map((hit, i) => {
          const href = hitHref(hit);
          return (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={href}>{hit.business.name}</a>
                <span class="rhs">
                  {hit.business.sample ? (
                    <span class="stamp">{t(locale, "sampleListing")}</span>
                  ) : (
                    categoryLabel(hit.business.categories[0] ?? "", locale)
                  )}
                </span>
              </div>
              <p class="index-desc">
                {hit.business.summary}
                {hit.place && hit.island
                  ? ` — ${hit.place.name}, ${islandName(locale, hit.island.slug, hit.island.name)}`
                  : ""}
              </p>
            </li>
          );
        })}
      </ol>
      </>
    )}
      </>
    )}
  </section>
</Base>
