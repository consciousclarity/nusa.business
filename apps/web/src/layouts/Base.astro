---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  crumb?: { label: string; href?: string }[];
}

const { title, description, crumb = [] } = Astro.props;
const portalUrl = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || "Local businesses across Indonesia"} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Nusa.Business</a>
      <nav>
        <a href="/claim">Claim</a>
        <a href={portalUrl}>Portal</a>
      </nav>
    </header>
    {crumb.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        {crumb.map((c, i) => (
          <span>
            {i > 0 && <span class="sep">/</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </span>
        ))}
      </nav>
    )}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Free local listings across the archipelago. No registration fees. No commission at launch.</p>
      <p><a href="https://bali.nusa.business/">bali.nusa.business</a> · <a href="https://gianyar.bali.nusa.business/">gianyar.bali</a> · <a href="/host/bali">Dev: /host/bali</a></p>
    </footer>
  </body>
</html>
