---
import Base from "../../../layouts/Base.astro";
import PlaceDirectory from "../../../components/PlaceDirectory.astro";
import CategoryBrowse from "../../../components/CategoryBrowse.astro";
import { api, apiOrNull, browserApiOrigin } from "../../../lib/api";
import { tenantHref } from "../../../lib/links";
import { resolveFacetBrowse, searchQueryForBrowse } from "../../../lib/facet-browse";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  hostPath as seoHostPath,
  localBusinessJsonLd,
  websiteJsonLd,
} from "../../../lib/seo";
import { inWhere, t, withLocale, weekdayLabel, type Locale } from "../../../i18n/ui";
import {
  categoryLabel,
  canonicalizeCategory,
  facetIndexPolicy,
  facetQueryParams,
  facetValueLabel,
  geoNesting,
  mapsHref,
  publicHostLine,
  telHref,
  websiteHref,
  whatsappHref,
  type NestablePlace,
} from "@nusa/shared";

type HubPlace = NestablePlace & { name: string; summary: string };

const label = Astro.params.label!;
const pathParts = String(Astro.params.path ?? "")
  .split("/")
  .filter(Boolean);
const parts = label.split(".");
const locale: Locale = Astro.locals.locale ?? "en";
if (parts.length !== 2) return Astro.redirect(`/host/${label}`);

const isFacetBrowse = pathParts[1] === "c";
if (isFacetBrowse) {
  if (pathParts.length !== 3 && pathParts.length !== 5) {
    return Astro.rewrite("/404");
  }
} else if (pathParts.length < 1 || pathParts.length > 2) {
  return Astro.rewrite("/404");
}

const [hostPlaceSlug, islandSlug] = parts;
const req = Astro.request;
const categoryParam = (Astro.url.searchParams.get("category") || "").trim();

const islandDetail = await apiOrNull<{
  island: { slug: string; name: string };
  places: HubPlace[];
}>(`/v1/islands/${islandSlug}`);
if (!islandDetail) return Astro.rewrite("/404");

const hostPlace = islandDetail.places.find((p) => p.slug === hostPlaceSlug);
if (!hostPlace) return Astro.rewrite("/404");

const placesById = Object.fromEntries(
  islandDetail.places.map((p) => [p.id, p]),
);
const hostNest = geoNesting(hostPlace, placesById);
if (hostNest.area) {
  const rest = pathParts.join("/");
  return Astro.redirect(
    withLocale(
      seoHostPath({
        island: islandSlug!,
        place: hostNest.hostPlace,
        area: hostNest.area,
        slug: rest || undefined,
      }),
      locale,
    ),
    301,
  );
}

type BrowseListing = {
  id: string;
  placeId: string;
  slug: string;
  name: string;
  summary: string;
  categories: string[];
  status?: string;
};

type AreaFacetPage = {
  area: HubPlace;
  browse: ReturnType<typeof resolveFacetBrowse> extends { ok: true; browse: infer B }
    ? B
    : never;
  listings: BrowseListing[];
  listingPlaces: Record<string, HubPlace>;
  canonical: string;
  robots: string;
  titleCore: string;
  formAction: string;
};

let areaFacet: AreaFacetPage | null = null;

if (isFacetBrowse) {
  const areaSlug = pathParts[0]!;
  const child = islandDetail.places.find(
    (p) =>
      p.slug === areaSlug &&
      p.parentPlaceId === hostPlace.id &&
      p.type === "tourist_area",
  );
  if (!child) return Astro.rewrite("/404");
  const resolved = resolveFacetBrowse(pathParts.slice(2), Astro.url.searchParams);
  if (!resolved.ok) return Astro.rewrite("/404");
  if (resolved.promoted) {
    const q = facetQueryParams(resolved.promoted).toString();
    return Astro.redirect(
      withLocale(
        seoHostPath({
          island: islandSlug!,
          place: hostPlaceSlug!,
          area: areaSlug,
          category: resolved.promoted.category,
          facet: resolved.promoted.pathFacet?.key,
          facetValue: resolved.promoted.pathFacet?.value,
        }) + (q ? `?${q}` : ""),
        locale,
      ),
      301,
    );
  }
  const searchQs = searchQueryForBrowse(islandSlug!, areaSlug, resolved.browse);
  const search = await api<{
    results: {
      business: BrowseListing;
      place: HubPlace;
    }[];
  }>(`/v1/search?${searchQs}`);
  const listings = search.results.map((r) => r.business);
  const policy = facetIndexPolicy(resolved.browse, {
    resultCount: listings.length,
  });
  const canonicalPath = withLocale(
    seoHostPath({
      island: islandSlug!,
      place: hostPlaceSlug!,
      area: areaSlug,
      category: resolved.browse.category,
      facet:
        policy.canonicalKind === "facet-path"
          ? resolved.browse.pathFacet?.key
          : undefined,
      facetValue:
        policy.canonicalKind === "facet-path"
          ? resolved.browse.pathFacet?.value
          : undefined,
    }),
    locale,
  );
  areaFacet = {
    area: child,
    browse: resolved.browse,
    listings,
    listingPlaces: Object.fromEntries(
      search.results.map((r) => [r.business.placeId, r.place]),
    ),
    canonical: absoluteUrl(req, canonicalPath),
    robots: policy.index ? "index,follow" : "noindex,follow",
    titleCore: resolved.browse.pathFacet
      ? `${facetValueLabel(resolved.browse.pathFacet.key, resolved.browse.pathFacet.value, locale)} ${categoryLabel(resolved.browse.category, locale)}`
      : categoryLabel(resolved.browse.category, locale),
    formAction: tenantHref(req, {
      island: islandSlug!,
      place: hostPlaceSlug!,
      area: areaSlug,
      category: resolved.browse.category,
      locale,
    }),
  };
}

type PlaceHubPayload = {
  island: { slug: string; name: string };
  place: HubPlace;
  parent?: HubPlace | null;
  children?: HubPlace[];
  businesses: {
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
    sample?: boolean;
    fieldRegistered?: boolean;
  }[];
};

let hub: PlaceHubPayload | null = null;
let placeSlug = hostPlaceSlug!;
let slug = pathParts[0]!;

if (!areaFacet) {
if (pathParts.length === 1) {
  const child = islandDetail.places.find(
    (p) =>
      p.slug === pathParts[0] &&
      p.parentPlaceId === hostPlace.id &&
      p.type === "tourist_area",
  );
  if (child) {
    hub = await apiOrNull<PlaceHubPayload>(
      `/v1/islands/${islandSlug}/places/${child.slug}`,
    );
    if (!hub) return Astro.rewrite("/404");
  }
} else if (!isFacetBrowse) {
  const areaSlug = pathParts[0]!;
  const areaPlace = islandDetail.places.find((p) => p.slug === areaSlug);
  if (!areaPlace) return Astro.rewrite("/404");
  const areaNest = geoNesting(areaPlace, placesById);
  if (areaNest.hostPlace !== hostPlaceSlug || !areaNest.area) {
    if (areaNest.area) {
      return Astro.redirect(
        withLocale(
          seoHostPath({
            island: islandSlug!,
            place: areaNest.hostPlace,
            area: areaNest.area,
            slug: pathParts[1],
          }),
          locale,
        ),
        301,
      );
    }
    return Astro.rewrite("/404");
  }
  placeSlug = areaSlug;
  slug = pathParts[1]!;
}
}

type ListingPayload = {
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    description: string;
    categories: string[];
    address?: string;
    phone?: string;
    whatsapp?: string;
    website?: string;
    lat?: number;
    lng?: number;
    bookingMode: string;
    status: string;
    sample?: boolean;
    verifiedAt?: string;
    openingHours: { day: string; open: string; close: string; closed?: boolean }[];
  };
  reviews: {
    authorName: string;
    service: number;
    value: number;
    location: number;
    cleanliness: number;
    comment: string;
  }[];
  vendor?: {
    id: string;
    name: string;
    description: string;
    products: { name: string; price: number; currency: string; stock: number; description: string }[];
  };
};

const data = hub || areaFacet
  ? null
  : await apiOrNull<ListingPayload>(
      `/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}`,
    );
if (!hub && !areaFacet && !data) return Astro.rewrite("/404");

const placeMeta = hub || areaFacet
  ? null
  : await api<{
      island: { name: string; slug: string };
      place: HubPlace;
      parent?: HubPlace | null;
    }>(`/v1/islands/${islandSlug}/places/${placeSlug}`);

const listingNest = placeMeta
  ? geoNesting(placeMeta.place, {
      [placeMeta.place.id]: placeMeta.place,
      ...(placeMeta.parent ? { [placeMeta.parent.id]: placeMeta.parent } : {}),
    })
  : hostNest;

const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
const listingPath = withLocale(
  seoHostPath({
    island: islandSlug!,
    place: listingNest.hostPlace,
    area: listingNest.area,
    slug: data ? slug : undefined,
  }),
  locale,
);
const listingUrl = absoluteUrl(req, listingPath);
const stamp = data?.business.sample
  ? t(locale, "sampleListing")
  : data?.business.status === "claimed"
    ? t(locale, "ownerVerified")
    : data?.business.status === "published"
      ? t(locale, "listedUnclaimed")
      : data?.business.status === "draft"
        ? t(locale, "listedUnclaimed")
        : null;

const wa = data ? whatsappHref(data.business.whatsapp) : null;
const phoneLink = data ? telHref(data.business.phone) : null;
const directionsLink = data
  ? mapsHref({
      address: data.business.address,
      lat: data.business.lat,
      lng: data.business.lng,
    })
  : null;
const siteLink = data ? websiteHref(data.business.website) : null;
const bookingToday = new Date().toISOString().slice(0, 10);
const listingCopy = {
  reviewSubmitting: t(locale, "reviewSubmitting"),
  reviewTooMany: t(locale, "reviewTooMany"),
  reviewTooManyRetry: t(locale, "reviewTooManyRetry"),
  networkRetry: t(locale, "networkRetry"),
  bookingSending: t(locale, "bookingSending"),
  bookingPendingOk: t(locale, "bookingPendingOk"),
  tooManyKept: t(locale, "tooManyKept"),
  tooManyRetryKept: t(locale, "tooManyRetryKept"),
  networkKept: t(locale, "networkKept"),
  reportSending: t(locale, "reportSending"),
  reportReceived: t(locale, "reportReceived"),
  reportNetwork: t(locale, "reportNetwork"),
  bookingPastDate: t(locale, "bookingPastDate"),
  bookingNeedEndDate: t(locale, "bookingNeedEndDate"),
  bookingNeedTickets: t(locale, "bookingNeedTickets"),
  bookingEndBeforeStart: t(locale, "bookingEndBeforeStart"),
  bookingDuplicate: t(locale, "bookingDuplicate"),
  bookingDisabled: t(locale, "bookingDisabled"),
  bookingRejected: t(locale, "bookingRejected"),
  reviewFailed: t(locale, "reviewFailed"),
  reportFailed: t(locale, "reportFailed"),
  requestFailed: t(locale, "requestFailed"),
  mapHere: t(locale, "mapHere"),
  kmAway: t(locale, "kmAway"),
};

type DiscoveryNeighbor = {
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    categories: string[];
    lat?: number;
    lng?: number;
  };
  place: { slug: string; name: string };
  island: { slug: string };
  geo?: { hostPlace: string; area?: string };
  distanceKm: number;
};

type DiscoveryPayload = {
  origin: { lat: number; lng: number; address?: string } | null;
  sameAddress: DiscoveryNeighbor[];
  similar: DiscoveryNeighbor[];
  nearbyCategories: string[];
  nearby: DiscoveryNeighbor[];
  activeCategory: string | null;
  radiusKm: number;
};

const emptyDiscovery: DiscoveryPayload = {
  origin: null,
  sameAddress: [],
  similar: [],
  nearbyCategories: [],
  nearby: [],
  activeCategory: null,
  radiusKm: 0,
};

const discovery = data
  ? await api<DiscoveryPayload>(
      `/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}/discovery`,
    ).catch(() => emptyDiscovery)
  : emptyDiscovery;

function neighborHref(n: DiscoveryNeighbor) {
  return tenantHref(req, {
    island: n.island.slug,
    place: n.geo?.hostPlace ?? n.place.slug,
    area: n.geo?.area,
    slug: n.business.slug,
    locale,
  });
}

const discoveryApi = data
  ? `${browserApiOrigin()}/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}/discovery`
  : "";

const HREF_TOKEN = {
  island: "x-island-x",
  place: "x-place-x",
  area: "x-area-x",
  slug: "x-slug-x",
};
const neighborHrefTemplate = tenantHref(req, {
  island: HREF_TOKEN.island,
  place: HREF_TOKEN.place,
  area: HREF_TOKEN.area,
  slug: HREF_TOKEN.slug,
  locale,
});

const nearbySeed = JSON.stringify({
  origin: discovery.origin,
  nearby: discovery.nearby.map((n) => ({
    business: {
      name: n.business.name,
      slug: n.business.slug,
      summary: n.business.summary,
      lat: n.business.lat,
      lng: n.business.lng,
    },
    place: { slug: n.place.slug, name: n.place.name },
    island: { slug: n.island.slug },
    geo: n.geo,
    distanceKm: n.distanceKm,
  })),
});
const nearbyWithHref = discovery.nearby.map((n) => ({
  ...n,
  href: neighborHref(n),
}));

const hubCanonical =
  hub &&
  absoluteUrl(
    req,
    withLocale(
      seoHostPath({
        island: hub.island.slug,
        place: hostPlaceSlug!,
        area: hub.place.slug,
      }),
      locale,
    ),
  );
const hubQuery = hub
  ? publicHostLine({
      island: hub.island.slug,
      place: hostPlaceSlug!,
      area: hub.place.slug,
    })
  : "";

if (hub && categoryParam) {
  const slug = canonicalizeCategory(categoryParam);
  if (slug) {
    return Astro.redirect(
      withLocale(
        seoHostPath({
          island: hub.island.slug,
          place: hostPlaceSlug!,
          area: hub.place.slug,
          category: slug,
        }),
        locale,
      ),
      301,
    );
  }
}
---
{areaFacet && (
  <Base
    title={`${inWhere(locale, areaFacet.titleCore, areaFacet.area.name)} — nusa.business`}
    description={`${areaFacet.listings.length} ${t(locale, "listingsCount")} ${t(locale, "inWhere")} ${areaFacet.area.name}.`}
    crumb={[
      {
        label: islandDetail.island.name,
        href: tenantHref(req, { island: islandSlug!, locale }),
      },
      {
        label: hostPlace.name,
        href: tenantHref(req, {
          island: islandSlug!,
          place: hostPlaceSlug!,
          locale,
        }),
      },
      {
        label: areaFacet.area.name,
        href: tenantHref(req, {
          island: islandSlug!,
          place: hostPlaceSlug!,
          area: areaFacet.area.slug,
          locale,
        }),
      },
      { label: areaFacet.titleCore },
    ]}
    locale={locale}
    canonical={areaFacet.canonical}
    robots={areaFacet.robots}
    jsonLd={[
      websiteJsonLd({
        locale,
        url: areaFacet.canonical,
        name: inWhere(locale, areaFacet.titleCore, areaFacet.area.name),
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: absoluteUrl(req, withLocale("/", locale)) },
        {
          name: islandDetail.island.name,
          url: absoluteUrl(
            req,
            withLocale(seoHostPath({ island: islandSlug! }), locale),
          ),
        },
        {
          name: hostPlace.name,
          url: absoluteUrl(
            req,
            withLocale(
              seoHostPath({ island: islandSlug!, place: hostPlaceSlug! }),
              locale,
            ),
          ),
        },
        { name: areaFacet.area.name, url: areaFacet.canonical },
      ]),
    ]}
  >
    <CategoryBrowse
      island={islandDetail.island}
      hostPlace={hostPlace}
      area={areaFacet.area}
      places={islandDetail.places}
      listings={areaFacet.listings}
      listingPlaces={areaFacet.listingPlaces}
      browse={areaFacet.browse}
      locale={locale}
      formAction={areaFacet.formAction}
    />
  </Base>
)}
{hub && hubCanonical && (
  <Base
    title={`${hub.place.name}, ${hub.island.name} — nusa.business`}
    description={hub.place.summary}
    crumb={[
      {
        label: hub.island.name,
        href: tenantHref(req, { island: hub.island.slug, locale }),
      },
      {
        label: hostPlace.name,
        href: tenantHref(req, {
          island: hub.island.slug,
          place: hostPlaceSlug!,
          locale,
        }),
      },
      { label: hub.place.name },
    ]}
    locale={locale}
    canonical={hubCanonical}
    jsonLd={[
      websiteJsonLd({
        locale,
        url: hubCanonical,
        name: `${hub.place.name}, ${hub.island.name}`,
        description: hub.place.summary,
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: absoluteUrl(req, withLocale("/", locale)) },
        {
          name: hub.island.name,
          url: absoluteUrl(
            req,
            withLocale(seoHostPath({ island: hub.island.slug }), locale),
          ),
        },
        {
          name: hostPlace.name,
          url: absoluteUrl(
            req,
            withLocale(
              seoHostPath({
                island: hub.island.slug,
                place: hostPlaceSlug!,
              }),
              locale,
            ),
          ),
        },
        { name: hub.place.name, url: hubCanonical },
      ]),
    ]}
  >
    <PlaceDirectory
      island={hub.island}
      place={hub.place}
      parent={hub.parent}
      children={hub.children ?? []}
      businesses={hub.businesses}
      queryHost={hubQuery}
      locale={locale}
      categoryParam={categoryParam}
    />
  </Base>
)}
{data && placeMeta && (
<Base
  title={`${data.business.name} — ${placeMeta.place.name}`}
  description={data.business.summary}
  crumb={[
    { label: placeMeta.island.name, href: tenantHref(req, { island: islandSlug!, locale }) },
    ...(listingNest.area
      ? [
          {
            label: placeMeta.parent?.name ?? listingNest.hostPlace,
            href: tenantHref(req, {
              island: islandSlug!,
              place: listingNest.hostPlace,
              locale,
            }),
          },
          {
            label: placeMeta.place.name,
            href: tenantHref(req, {
              island: islandSlug!,
              place: listingNest.hostPlace,
              area: listingNest.area,
              locale,
            }),
          },
        ]
      : [
          {
            label: placeMeta.place.name,
            href: tenantHref(req, {
              island: islandSlug!,
              place: listingNest.hostPlace,
              locale,
            }),
          },
        ]),
    { label: data.business.name },
  ]}
  locale={locale}
  canonical={listingUrl}
  ogType="article"
  jsonLd={[
    localBusinessJsonLd({
      name: data.business.name,
      description: data.business.summary,
      url: listingUrl,
      address: data.business.address,
      telephone: data.business.phone,
      categories: data.business.categories,
      lat: data.business.lat,
      lng: data.business.lng,
      locale,
      openingHours: data.business.openingHours,
    }),
    breadcrumbJsonLd([
      { name: "nusa.business", url: absoluteUrl(req, withLocale("/", locale)) },
      {
        name: placeMeta.island.name,
        url: absoluteUrl(
          req,
          withLocale(seoHostPath({ island: islandSlug! }), locale),
        ),
      },
      {
        name: listingNest.area
          ? (placeMeta.parent?.name ?? listingNest.hostPlace)
          : placeMeta.place.name,
        url: absoluteUrl(
          req,
          withLocale(
            seoHostPath({
              island: islandSlug!,
              place: listingNest.hostPlace,
            }),
            locale,
          ),
        ),
      },
      ...(listingNest.area
        ? [
            {
              name: placeMeta.place.name,
              url: absoluteUrl(
                req,
                withLocale(
                  seoHostPath({
                    island: islandSlug!,
                    place: listingNest.hostPlace,
                    area: listingNest.area,
                  }),
                  locale,
                ),
              ),
            },
          ]
        : []),
      { name: data.business.name, url: listingUrl },
    ]),
  ]}
>
  <article class="record">
    <h1>{data.business.name}</h1>
    <p class="prose">{data.business.summary}</p>
    {stamp && <span class="stamp">{stamp}</span>}

    <dl class="kv">
      <dt>{t(locale, "category")}</dt>
      <dd>{data.business.categories.map((c) => categoryLabel(c, locale)).join(" · ") || "—"}</dd>
      {data.business.address && (
        <>
          <dt>{t(locale, "addressLabel")}</dt>
          <dd>{data.business.address}</dd>
        </>
      )}
      {data.business.phone && (
        <>
          <dt>{t(locale, "phoneLabel")}</dt>
          <dd>
            {phoneLink ? (
              <a href={phoneLink}>{data.business.phone}</a>
            ) : (
              data.business.phone
            )}
          </dd>
        </>
      )}
      {data.business.whatsapp && (
        <>
          <dt>WhatsApp</dt>
          <dd>
            {wa ? (
              <a href={wa} rel="noopener noreferrer">
                {data.business.whatsapp}
              </a>
            ) : (
              data.business.whatsapp
            )}
          </dd>
        </>
      )}
      {data.business.verifiedAt && (
        <>
          <dt>{t(locale, "lastVerified")}</dt>
          <dd>
            {new Date(data.business.verifiedAt).toLocaleDateString(
              locale === "id" ? "id-ID" : "en-GB",
              { dateStyle: "medium" },
            )}
          </dd>
        </>
      )}
    </dl>

    <p class="actions">
      {directionsLink && (
        <a class="cta" href={directionsLink} rel="noopener noreferrer">
          {t(locale, "directions")}
        </a>
      )}
      {phoneLink && (
        <a class={`cta${directionsLink ? " secondary" : ""}`} href={phoneLink}>
          {t(locale, "call")}
        </a>
      )}
      {siteLink && (
        <a
          class="cta secondary"
          href={siteLink}
          rel="noopener noreferrer"
        >
          {t(locale, "website")}
        </a>
      )}
      {wa && (
        <a class="cta secondary" href={wa} rel="noopener noreferrer">
          {t(locale, "chatWhatsApp")}
        </a>
      )}
      {data.business.bookingMode !== "none" && (
        <a class="cta secondary" href="#book">{t(locale, "book")}</a>
      )}
      <a
        class="cta secondary"
        href={`${portal}/claim?businessId=${data.business.id}`}
      >
        {t(locale, "claimThis")}
      </a>
    </p>
  </article>

  <div class="stack">
    <section class="section">
      <h2>{t(locale, "overview")}</h2>
      <p class="prose">{data.business.description}</p>
    </section>

    {discovery.sameAddress.length > 0 && (
      <section class="section" aria-labelledby="same-address-heading">
        <h2 id="same-address-heading">{t(locale, "otherAtAddress")}</h2>
        <p class="meta">{data.business.address}</p>
        <ol class="index-list">
          {discovery.sameAddress.map((n, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={neighborHref(n)}>{n.business.name}</a>
                <span class="rhs">{categoryLabel(n.business.categories[0] ?? "", locale) || n.place.name}</span>
              </div>
              <p class="index-desc">{n.business.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {discovery.similar.length > 0 && (
      <section class="section" aria-labelledby="similar-heading">
        <h2 id="similar-heading">{t(locale, "similarNearby")}</h2>
        <ol class="index-list">
          {discovery.similar.map((n, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <a class="name" href={neighborHref(n)}>{n.business.name}</a>
                <span class="rhs">
                  {n.distanceKm.toFixed(2)} {t(locale, "kmAway")} · {n.place.name}
                </span>
              </div>
              <p class="index-desc">{n.business.summary}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {discovery.origin && discovery.nearbyCategories.length > 0 && (
      <section
        class="section nearby-discovery"
        aria-labelledby="nearby-cat-heading"
        data-nearby-root
        data-endpoint={discoveryApi}
        data-active-category={discovery.activeCategory ? encodeURIComponent(discovery.activeCategory) : ""}
        data-empty-label={t(locale, "noNearbyInCategory")}
        data-href-template={neighborHrefTemplate}
        data-initial={nearbySeed}
      >
        <h2 id="nearby-cat-heading">{t(locale, "nearbyByCategory")}</h2>
        <div
          class="category-chips"
          role="group"
          aria-label={t(locale, "category")}
        >
          {discovery.nearbyCategories.map((cat) => (
            <button
              type="button"
              class:list={["chip", { "is-active": cat === discovery.activeCategory }]}
              data-category={encodeURIComponent(cat)}
              aria-pressed={cat === discovery.activeCategory ? "true" : "false"}
            >
              {categoryLabel(cat, locale)}
            </button>
          ))}
        </div>
        <div class="nearby-layout">
          <div
            class="nearby-map"
            data-nearby-map
            hidden
            role="img"
            aria-label={t(locale, "nearbyMap")}
          ></div>
          <div data-nearby-list>
            {nearbyWithHref.length === 0 ? (
              <p class="meta">{t(locale, "noNearbyInCategory")}</p>
            ) : (
              <ol class="index-list">
                {nearbyWithHref.map((n, i) => (
                  <li>
                    <div class="index-row">
                      <span class="n">{String(i + 1).padStart(2, "0")}</span>
                      <a class="name" href={n.href}>{n.business.name}</a>
                      <span class="rhs">
                        {n.distanceKm.toFixed(2)} {t(locale, "kmAway")}
                      </span>
                    </div>
                    <p class="index-desc">{n.business.summary}</p>
                  </li>
                ))}
              </ol>
            )}
          </div>
        </div>
      </section>
    )}

    {data.business.openingHours?.length > 0 && (
      <section class="section" aria-labelledby="hours-caption">
        <div class="table-wrap">
          <table class="data">
            <caption id="hours-caption">{t(locale, "openingHours")}</caption>
            <thead>
              <tr>
                <th scope="col">{t(locale, "day")}</th>
                <th scope="col">{t(locale, "hours")}</th>
              </tr>
            </thead>
            <tbody>
              {data.business.openingHours.map((h) => (
                <tr>
                  <th scope="row">{weekdayLabel(locale, h.day)}</th>
                  <td>{h.closed ? t(locale, "closed") : `${h.open} – ${h.close}`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {data.vendor && (
      <section class="section">
        <h2>{t(locale, "shop")} · {data.vendor.name}</h2>
        <p class="prose">{data.vendor.description}</p>
        <p class="meta">{t(locale, "shopNote")}</p>
        <ol class="index-list">
          {data.vendor.products.map((p, i) => (
            <li>
              <div class="index-row">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <span class="name">{p.name}</span>
                <span class="rhs">
                  {p.price.toLocaleString("id-ID")} {p.currency} · {p.stock} {t(locale, "available")}
                </span>
              </div>
              <p class="index-desc">{p.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="section" id="reviews">
      <h2>{t(locale, "reviews")}</h2>
      {data.reviews.length === 0 && <p class="meta">{t(locale, "noReviews")}</p>}
      {data.reviews.length > 0 && (
        <div class="table-wrap">
          <table class="data">
            <caption>{t(locale, "reviewScores")}</caption>
            <thead>
              <tr>
                <th scope="col">{t(locale, "author")}</th>
                <th scope="col">{t(locale, "scoreService")}</th>
                <th scope="col">{t(locale, "scoreValue")}</th>
                <th scope="col">{t(locale, "scoreLocation")}</th>
                <th scope="col">{t(locale, "scoreCleanliness")}</th>
              </tr>
            </thead>
            <tbody>
              {data.reviews.map((r) => (
                <tr>
                  <th scope="row">{r.authorName}</th>
                  <td>{r.service}/5</td>
                  <td>{r.value}/5</td>
                  <td>{r.location}/5</td>
                  <td>{r.cleanliness}/5</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {data.reviews.map((r) => (
        <p class="prose review-note">
          <strong>{r.authorName}:</strong> {r.comment}
        </p>
      ))}

      <form class="stack" method="POST" id="review-form">
        <h3>{t(locale, "addReview")}</h3>
        <label>{t(locale, "reviewName")} <input name="authorName" required autocomplete="nickname" /></label>
        <label>{t(locale, "reviewComment")} <textarea name="comment" required rows="3"></textarea></label>
        <fieldset class="scores">
          <legend>{t(locale, "reviewScoresLegend")}</legend>
          <label>{t(locale, "scoreService")} <input type="number" name="service" min="1" max="5" value="5" required /></label>
          <label>{t(locale, "scoreValue")} <input type="number" name="value" min="1" max="5" value="5" required /></label>
          <label>{t(locale, "scoreLocation")} <input type="number" name="location" min="1" max="5" value="5" required /></label>
          <label>
            {t(locale, "scoreCleanliness")}
            <input type="number" name="cleanliness" min="1" max="5" value="5" required />
          </label>
        </fieldset>
        <button type="submit">{t(locale, "reviewSubmit")}</button>
        <p class="meta" id="review-msg" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section class="section" id="report">
      <h2>{t(locale, "suggestCorrection")}</h2>
      <form class="stack" id="report-form">
        <label>
          {t(locale, "reportNote")}
          <textarea name="note" required minlength="12" rows="3"></textarea>
        </label>
        <label>
          {t(locale, "reportKind")}
          <select name="kind">
            <option value="correction">{t(locale, "reportCorrection")}</option>
            <option value="abuse">{t(locale, "reportAbuseKind")}</option>
          </select>
        </label>
        <button type="submit">{t(locale, "reportSend")}</button>
        <p class="meta" id="report-msg" role="status" aria-live="polite"></p>
      </form>
    </section>

    {data.business.bookingMode !== "none" && (
      <section class="section" id="book">
        <h2>{t(locale, "bookingTitle")}</h2>
        <p class="meta" id="booking-notice">
          {t(locale, "bookingNotice")}
        </p>
        <form
          class="stack"
          id="booking-form"
          aria-describedby="booking-notice"
        >
          <label>{t(locale, "customerName")} <input name="customerName" required autocomplete="name" /></label>
          <label>{t(locale, "customerEmail")} <input type="email" name="customerEmail" required autocomplete="email" /></label>
          <label>{t(locale, "bookingDate")} <input type="date" name="startDate" required min={bookingToday} /></label>
          {data.business.bookingMode === "service" && (
            <label>{t(locale, "timeSlot")} <input name="timeSlot" placeholder="10:00" /></label>
          )}
          {data.business.bookingMode === "rental" && (
            <label>{t(locale, "endDate")} <input type="date" name="endDate" required min={bookingToday} /></label>
          )}
          {data.business.bookingMode === "event" && (
            <label>{t(locale, "tickets")} <input type="number" name="tickets" min="1" value="1" required /></label>
          )}
          <button type="submit">{t(locale, "bookingSubmit")}</button>
          <p class="meta" id="booking-msg" role="status" aria-live="polite"></p>
        </form>
      </section>
    )}
  </div>
</Base>

<script define:vars={{ apiBase: browserApiOrigin(), businessId: data?.business.id ?? "", listingCopy }}>
  const L = typeof listingCopy === "undefined" ? {} : listingCopy;
  function txt(key, fallback) {
    return L[key] || fallback;
  }
  function withN(key, fallback, n) {
    return txt(key, fallback).replace("{n}", String(n ?? ""));
  }
  const errorCodes = {
    BOOKING_PAST_DATE: ["bookingPastDate", "Date must be today or later."],
    BOOKING_NEED_END_DATE: ["bookingNeedEndDate", "Rentals need an end date."],
    BOOKING_NEED_TICKETS: ["bookingNeedTickets", "Events need a ticket count."],
    BOOKING_END_BEFORE_START: [
      "bookingEndBeforeStart",
      "End date must be on or after the start date.",
    ],
    BOOKING_DUPLICATE: [
      "bookingDuplicate",
      "A pending request already exists for these dates.",
    ],
    BOOKING_NOT_ENABLED: ["bookingDisabled", "Booking is not available for this listing."],
  };
  function visitorError(kind, status, data) {
    const mapped = data && data.code ? errorCodes[data.code] : null;
    if (mapped) return txt(mapped[0], mapped[1]);
    if (kind === "booking") {
      if (status === 409) {
        return txt("bookingDuplicate", "A pending request already exists for these dates.");
      }
      return txt("bookingRejected", "Request could not be sent. Check the dates and try again.");
    }
    if (kind === "review") return txt("reviewFailed", "Review could not be sent. Try again.");
    if (kind === "report") return txt("reportFailed", "Report could not be sent. Try again.");
    return txt("requestFailed", "Could not send. Try again.");
  }
  function setStatus(el, text, isError) {
    if (!el) return;
    el.textContent = text;
    el.classList.toggle("error", !!isError);
    const form = el.closest("form");
    if (form) {
      if (isError) form.setAttribute("aria-invalid", "true");
      else form.removeAttribute("aria-invalid");
    }
  }

  function lockForm(form, locked) {
    form.querySelectorAll("button, input, textarea, select").forEach((node) => {
      node.disabled = locked;
    });
  }

  const reviewForm = document.getElementById("review-form");
  const reviewMsg = document.getElementById("review-msg");
  reviewForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (reviewForm.dataset.busy === "1") return;
    const fd = new FormData(reviewForm);
    reviewForm.dataset.busy = "1";
    lockForm(reviewForm, true);
    setStatus(reviewMsg, txt("reviewSubmitting", "Submitting review…"), false);
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/reviews`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          authorName: fd.get("authorName"),
          comment: fd.get("comment"),
          service: Number(fd.get("service")),
          value: Number(fd.get("value")),
          location: Number(fd.get("location")),
          cleanliness: Number(fd.get("cleanliness")),
        }),
      });
      if (res.ok) {
        location.reload();
        return;
      }
      let data = {};
      try {
        data = await res.json();
      } catch {}
      let detail = visitorError("review", res.status, data);
      if (res.status === 429) {
        const ra = res.headers.get("Retry-After");
        detail = ra
          ? withN("reviewTooManyRetry", "Too many reviews — retry in {n}s.", ra)
          : txt("reviewTooMany", "Too many reviews — try later.");
      }
      setStatus(reviewMsg, detail, true);
    } catch {
      setStatus(reviewMsg, txt("networkRetry", "Network error — check your connection and try again."), true);
    } finally {
      reviewForm.dataset.busy = "0";
      lockForm(reviewForm, false);
    }
  });

  const bookingForm = document.getElementById("booking-form");
  const bookingMsg = document.getElementById("booking-msg");
  let bookingIdempotencyKey = crypto.randomUUID();
  let lastBookingPayload;
  bookingForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (bookingForm.dataset.busy === "1") return;
    // Disabled controls are omitted by FormData, so capture values before locking.
    const fd = new FormData(bookingForm);
    bookingForm.dataset.busy = "1";
    lockForm(bookingForm, true);
    setStatus(bookingMsg, txt("bookingSending", "Sending request…"), false);
    const payload = {
      customerName: fd.get("customerName"),
      customerEmail: fd.get("customerEmail"),
      startDate: fd.get("startDate"),
      endDate: fd.get("endDate") || undefined,
      timeSlot: fd.get("timeSlot") || undefined,
      tickets: fd.get("tickets") ? Number(fd.get("tickets")) : undefined,
    };
    const serializedPayload = JSON.stringify(payload);
    if (lastBookingPayload !== undefined && lastBookingPayload !== serializedPayload) {
      bookingIdempotencyKey = crypto.randomUUID();
    }
    lastBookingPayload = serializedPayload;
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/bookings`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          "idempotency-key": bookingIdempotencyKey,
        },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        setStatus(
          bookingMsg,
          txt("bookingPendingOk", "Request recorded as pending. This is not a confirmed reservation."),
          false,
        );
        bookingForm.reset();
        bookingIdempotencyKey = crypto.randomUUID();
      } else {
        let data = {};
        try {
          data = await res.json();
        } catch {}
        let detail = visitorError("booking", res.status, data);
        if (res.status === 429) {
          const ra = res.headers.get("Retry-After");
          detail = ra
            ? withN("tooManyRetryKept", "Too many requests — retry in {n}s. Your form was kept.", ra)
            : txt("tooManyKept", "Too many requests — try later. Your form was kept.");
        }
        setStatus(bookingMsg, detail, true);
      }
    } catch {
      setStatus(
        bookingMsg,
        txt("networkKept", "Network error — your details were kept. Try again."),
        true,
      );
    } finally {
      bookingForm.dataset.busy = "0";
      lockForm(bookingForm, false);
    }
  });

  const reportForm = document.getElementById("report-form");
  const reportMsg = document.getElementById("report-msg");
  reportForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (reportForm.dataset.busy === "1") return;
    const fd = new FormData(reportForm);
    reportForm.dataset.busy = "1";
    lockForm(reportForm, true);
    setStatus(reportMsg, txt("reportSending", "Sending report…"), false);
    try {
      const res = await fetch(`${apiBase}/v1/businesses/${businessId}/reports`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          kind: fd.get("kind") || "correction",
          note: fd.get("note"),
        }),
      });
      if (res.ok) {
        setStatus(reportMsg, txt("reportReceived", "Report received. Operators will review it."), false);
        reportForm.reset();
      } else {
        let data = {};
        try {
          data = await res.json();
        } catch {}
        setStatus(reportMsg, visitorError("report", res.status, data), true);
      }
    } catch {
      setStatus(reportMsg, txt("reportNetwork", "Network error — your note was kept. Try again."), true);
    } finally {
      reportForm.dataset.busy = "0";
      lockForm(reportForm, false);
    }
  });
  // Written by apps/web/scripts/copy-vendor.mjs into public/vendor/.
  const leafletJs = "/vendor/leaflet/leaflet.js";
  const leafletCss = "/vendor/leaflet/leaflet.css";

  // —— Nearby discovery ————————————————————————————————————————————
  // The list is server-rendered; this only adds category switching and the
  // map. Leaflet (~148 KB) is fetched from our own origin the first time the
  // map is about to come into view, so readers who never scroll there — the
  // 3G phone case the performance budget is written for — never pay for it.
  const nearbyRoot = document.querySelector("[data-nearby-root]");
  if (nearbyRoot) initNearby(nearbyRoot);

  function initNearby(root) {
    const endpoint = root.dataset.endpoint;
    const emptyLabel = root.dataset.emptyLabel || "";
    const listEl = root.querySelector("[data-nearby-list]");
    const mapEl = root.querySelector("[data-nearby-map]");
    const chips = Array.from(root.querySelectorAll("[data-category]"));
    if (!endpoint || !listEl || !mapEl) return;

    const hrefTemplate = root.dataset.hrefTemplate || "";
    let map = null;
    let layer = null;
    let seq = 0;

    // Seeded from the server so the map agrees with the rendered list the
    // moment it opens, without spending a request to re-fetch what is
    // already on the page.
    let latest = { origin: null, items: [] };
    try {
      const seed = JSON.parse(root.dataset.initial || "null");
      if (seed) latest = { origin: seed.origin, items: seed.nearby || [] };
    } catch {
      // Keep the empty default; the map simply opens without markers.
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    // Substituted into the template tenantHref produced for this request, so
    // refetched links keep the locale prefix and the canonical tenant host.
    // One pass: chained replaces would re-scan text they had just inserted,
    // so a slug that happens to read "x-slug-x" could rewrite the hostname.
    function hrefFor(n) {
      const geo = n.geo || {};
      const area = geo.area || "";
      let href = hrefTemplate;
      if (area) {
        href = href.replaceAll("x-area-x", area);
      } else {
        href = href.replace("/x-area-x", "");
      }
      const values = {
        "x-place-x": geo.hostPlace || n.place.slug,
        "x-island-x": n.island.slug,
        "x-slug-x": n.business.slug,
      };
      return href.replace(
        /x-(?:place|island|slug)-x/g,
        (token) => values[token],
      );
    }

    function renderList(items) {
      if (items.length === 0) {
        listEl.innerHTML = `<p class="meta">${escapeHtml(emptyLabel)}</p>`;
        return;
      }
      const ol = document.createElement("ol");
      ol.className = "index-list";
      items.forEach((n, i) => {
        const li = document.createElement("li");
        li.innerHTML = `
      <div class="index-row">
        <span class="n">${String(i + 1).padStart(2, "0")}</span>
        <a class="name" href="${escapeHtml(hrefFor(n))}">${escapeHtml(n.business.name)}</a>
        <span class="rhs">${n.distanceKm.toFixed(2)} ${txt("kmAway", "km")}</span>
      </div>
      <p class="index-desc">${escapeHtml(n.business.summary)}</p>`;
        ol.appendChild(li);
      });
      listEl.replaceChildren(ol);
    }

    function syncMap() {
      if (!map || !layer) return;
      const L = window.L;
      layer.clearLayers();
      const bounds = [];
      if (latest.origin) {
        layer.addLayer(
          L.circleMarker([latest.origin.lat, latest.origin.lng], {
            radius: 7,
            color: "#1a1c22",
            fillColor: "#1a1c22",
            fillOpacity: 1,
            weight: 1,
          }).bindPopup(txt("mapHere", "Here")),
        );
        bounds.push([latest.origin.lat, latest.origin.lng]);
      }
      latest.items.forEach((n, i) => {
        if (typeof n.business.lat !== "number" || typeof n.business.lng !== "number") {
          return;
        }
        layer.addLayer(
          L.circleMarker([n.business.lat, n.business.lng], {
            radius: 6,
            color: "#1a29c4",
            fillColor: "#1a29c4",
            fillOpacity: 0.85,
            weight: 1,
          }).bindPopup(
            `<strong>${String(i + 1).padStart(2, "0")}. ${escapeHtml(n.business.name)}</strong><br>${n.distanceKm.toFixed(2)} ${txt("kmAway", "km")}`,
          ),
        );
        bounds.push([n.business.lat, n.business.lng]);
      });
      if (bounds.length > 0) {
        map.fitBounds(L.latLngBounds(bounds), { padding: [24, 24], maxZoom: 15 });
      }
      map.invalidateSize();
    }

    let mapReady = null;
    function loadMap() {
      if (mapReady) return mapReady;
      mapReady = new Promise((resolve, reject) => {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = leafletCss;
        document.head.appendChild(link);
        const tag = document.createElement("script");
        tag.src = leafletJs;
        tag.onload = () => resolve(window.L);
        tag.onerror = () => reject(new Error("leaflet failed to load"));
        document.head.appendChild(tag);
      })
        .then((L) => {
          mapEl.hidden = false;
          map = L.map(mapEl, { scrollWheelZoom: false, attributionControl: true });
          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(map);
          layer = L.layerGroup().addTo(map);
          map.setView([-8.54, 115.32], 13);
          // Leaflet measures its pane after layout.
          requestAnimationFrame(() => {
            map.invalidateSize();
            syncMap();
          });
        })
        .catch(() => {
          // No map is fine — the list above it is the real content.
          mapEl.hidden = true;
        });
      return mapReady;
    }

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            void loadMap();
          }
        },
        { rootMargin: "200px" },
      );
      io.observe(root);
    } else {
      void loadMap();
    }

    async function load(category) {
      const mine = ++seq;
      const url = new URL(endpoint);
      if (category) url.searchParams.set("category", category);
      else url.searchParams.delete("category");
      let data;
      try {
        const res = await fetch(url.toString());
        if (!res.ok || mine !== seq) return;
        data = await res.json();
      } catch {
        return;
      }
      if (mine !== seq) return;
      chips.forEach((btn) => {
        const cat = decodeURIComponent(btn.dataset.category || "");
        const active = cat === (data.activeCategory ?? "");
        btn.setAttribute("aria-pressed", active ? "true" : "false");
        btn.classList.toggle("is-active", active);
      });
      latest = { origin: data.origin, items: data.nearby };
      renderList(latest.items);
      syncMap();
    }

    chips.forEach((btn) => {
      btn.addEventListener("click", () => {
        const raw = btn.dataset.category || "";
        void load(raw ? decodeURIComponent(raw) : null);
      });
    });
  }
</script>

<style>
  /* Listing-only styles: kept off global.css so every other page — and the
     shared stylesheet's budget — stays untouched by the discovery panels. */
  .nearby-layout {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.85rem;
  }

