# Nusa.Business — local overrides (copy from .env.example)
PORT=8787
NUSA_DATA_DIR=

# API bearer-token signing secret. Min 16 chars.
# REQUIRED in production — the API refuses to start without it when
# NODE_ENV=production. Generate with: openssl rand -hex 32
NUSA_AUTH_SECRET=
# Token lifetime in seconds (default 604800 = 7 days)
# NUSA_TOKEN_TTL=604800

# Rate limiting (apps/api/src/rate-limit.ts). Defaults shown; all optional.
# NUSA_RATELIMIT_LOGIN_MAX=30           # login attempts per client address
# NUSA_RATELIMIT_LOGIN_EMAIL_MAX=5      # login attempts per account
# NUSA_RATELIMIT_LOGIN_WINDOW_MS=900000 # 15 minutes
# NUSA_RATELIMIT_WRITE_MAX=20           # public writes per client, per listing
# NUSA_RATELIMIT_BUSINESS_WRITE_MAX=60  # public writes per listing, all clients
# NUSA_RATELIMIT_WRITE_WINDOW_MS=3600000
# NUSA_RATELIMIT_MAX_BUCKETS=20000      # ceiling on tracked keys
# NUSA_RATELIMIT_DISABLED=1             # local development escape hatch
#
# Trust CF-Connecting-IP for client identity. OFF by default: the origin is
# publicly reachable, so the header is forgeable by anyone connecting to it
# directly. Enable ONLY once the origin is firewalled to Cloudflare's ranges.
# NUSA_TRUST_CF_CONNECTING_IP=1

# Public web
PUBLIC_API_URL=http://localhost:8787
PUBLIC_PORTAL_URL=http://localhost:5173

# Portal
VITE_API_URL=http://localhost:8787

# Future Postgres
DATABASE_URL=postgres://nusa:nusa@localhost:5432/nusa

# Future search / objects
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nusa
MINIO_SECRET_KEY=nusaminiopass

# Auth cookie domain (production)
# AUTH_COOKIE_DOMAIN=.nusa.business

# Cloudflare (zone script + wrangler deploy)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Optional origin (Hostinger VPS for nusa.business)
# ORIGIN_IPV4=62.72.7.218
# NUSA_ZONE=nusa.business
