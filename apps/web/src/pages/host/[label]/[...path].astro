---
import Base from "../../../layouts/Base.astro";
import PlaceDirectory from "../../../components/PlaceDirectory.astro";
import CategoryBrowse from "../../../components/CategoryBrowse.astro";
import ListingRecord from "../../../components/ListingRecord.astro";
import { api, apiOrNull, apiTry, browserApiOrigin } from "../../../lib/api";
import { tenantHref, tenantAbsHref, nationAbsHref } from "../../../lib/links";
import { listingMarker, takeMarkers } from "../../../lib/map-markers";
import { resolveFacetBrowse, searchQueryForBrowse } from "../../../lib/facet-browse";
import {
  breadcrumbJsonLd,
  hostPath as seoHostPath,
  localBusinessJsonLd,
  websiteJsonLd,
} from "../../../lib/seo";
import { inWhere, islandName, t, withLocale, type Locale } from "../../../i18n/ui";
import {
  categoryLabel,
  canonicalizeCategory,
  facetIndexPolicy,
  facetQueryParams,
  facetValueLabel,
  geoNesting,
  publicHostLine,
  type NestablePlace,
} from "@nusa/shared";

type HubPlace = NestablePlace & { name: string; summary: string };

const label = Astro.params.label!;
const pathParts = String(Astro.params.path ?? "")
  .split("/")
  .filter(Boolean);
const parts = label.split(".");
const locale: Locale = Astro.locals.locale ?? "en";
if (parts.length !== 2) return Astro.redirect(`/host/${label}`);

const isFacetBrowse = pathParts[1] === "c";
if (isFacetBrowse) {
  if (pathParts.length !== 3 && pathParts.length !== 5) {
    return Astro.rewrite(withLocale("/404", locale));
  }
} else if (pathParts.length < 1 || pathParts.length > 2) {
  return Astro.rewrite(withLocale("/404", locale));
}

const [hostPlaceSlug, islandSlug] = parts;
const req = Astro.request;
const categoryParam = (Astro.url.searchParams.get("category") || "").trim();

const islandDetail = await apiOrNull<{
  island: { slug: string; name: string };
  places: HubPlace[];
}>(`/v1/islands/${islandSlug}`);
if (!islandDetail) return Astro.rewrite(withLocale("/404", locale));

let hostPlace = islandDetail.places.find((p) => p.slug === hostPlaceSlug);
const canonicalIsland = islandDetail.island;

if (!hostPlace) {
  const resolved = await apiOrNull<{
    island: { slug: string; name: string };
    place: HubPlace;
    parent?: HubPlace | null;
    children?: HubPlace[];
  }>(`/v1/islands/${islandSlug}/places/${hostPlaceSlug}`);
  if (!resolved) return Astro.rewrite(withLocale("/404", locale));
  const rest = pathParts.join("/");
  return Astro.redirect(
    withLocale(
      seoHostPath({
        island: resolved.island.slug,
        place: resolved.place.slug,
        slug: rest || undefined,
      }),
      locale,
    ),
    301,
  );
}

if (canonicalIsland.slug !== islandSlug) {
  const rest = pathParts.join("/");
  return Astro.redirect(
    withLocale(
      seoHostPath({
        island: canonicalIsland.slug,
        place: hostPlaceSlug,
        slug: rest || undefined,
      }),
      locale,
    ),
    301,
  );
}

const islandLabel = islandName(locale, canonicalIsland.slug, canonicalIsland.name);

const placesById = Object.fromEntries(
  islandDetail.places.map((p) => [p.id, p]),
);
const hostNest = geoNesting(hostPlace, placesById);
if (hostNest.area) {
  const rest = pathParts.join("/");
  return Astro.redirect(
    withLocale(
      seoHostPath({
        island: islandSlug!,
        place: hostNest.hostPlace,
        area: hostNest.area,
        slug: rest || undefined,
      }),
      locale,
    ),
    301,
  );
}

type BrowseListing = {
  id: string;
  placeId: string;
  slug: string;
  name: string;
  summary: string;
  categories: string[];
  status?: string;
};

type AreaFacetPage = {
  area: HubPlace;
  browse: ReturnType<typeof resolveFacetBrowse> extends { ok: true; browse: infer B }
    ? B
    : never;
  listings: BrowseListing[];
  listingPlaces: Record<string, HubPlace>;
  canonical: string;
  robots: string;
  titleCore: string;
  formAction: string;
  unavailable?: boolean;
};

let areaFacet: AreaFacetPage | null = null;

if (isFacetBrowse) {
  const areaSlug = pathParts[0]!;
  const child = islandDetail.places.find(
    (p) =>
      p.slug === areaSlug &&
      p.parentPlaceId === hostPlace.id &&
      p.type === "tourist_area",
  );
  if (!child) return Astro.rewrite(withLocale("/404", locale));
  const resolved = resolveFacetBrowse(pathParts.slice(2), Astro.url.searchParams);
  if (!resolved.ok) return Astro.rewrite(withLocale("/404", locale));
  if (resolved.promoted) {
    const q = facetQueryParams(resolved.promoted).toString();
    return Astro.redirect(
      withLocale(
        seoHostPath({
          island: islandSlug!,
          place: hostPlaceSlug!,
          area: areaSlug,
          category: resolved.promoted.category,
          facet: resolved.promoted.pathFacet?.key,
          facetValue: resolved.promoted.pathFacet?.value,
        }) + (q ? `?${q}` : ""),
        locale,
      ),
      301,
    );
  }
  const searchQs = searchQueryForBrowse(islandSlug!, areaSlug, resolved.browse);
  const search = await apiTry<{
    results: {
      business: BrowseListing;
      place: HubPlace;
    }[];
  }>(`/v1/search?${searchQs}`);
  const searchFailed = search === null;
  const listings = search?.results.map((r) => r.business) ?? [];
  const policy = facetIndexPolicy(resolved.browse, {
    resultCount: searchFailed ? 0 : listings.length,
  });
  areaFacet = {
    area: child,
    browse: resolved.browse,
    listings,
    listingPlaces: Object.fromEntries(
      (search?.results ?? []).map((r) => [r.business.placeId, r.place]),
    ),
    canonical: tenantAbsHref(req, {
      island: islandSlug!,
      place: hostPlaceSlug!,
      area: areaSlug,
      category: resolved.browse.category,
      facet:
        policy.canonicalKind === "facet-path"
          ? resolved.browse.pathFacet?.key
          : undefined,
      facetValue:
        policy.canonicalKind === "facet-path"
          ? resolved.browse.pathFacet?.value
          : undefined,
      locale,
    }),
    robots: searchFailed || !policy.index ? "noindex,follow" : "index,follow",
    titleCore: resolved.browse.pathFacet
      ? `${facetValueLabel(resolved.browse.pathFacet.key, resolved.browse.pathFacet.value, locale)} ${categoryLabel(resolved.browse.category, locale)}`
      : categoryLabel(resolved.browse.category, locale),
    formAction: tenantHref(req, {
      island: islandSlug!,
      place: hostPlaceSlug!,
      area: areaSlug,
      category: resolved.browse.category,
      locale,
    }),
    unavailable: searchFailed,
  };
}

type PlaceHubPayload = {
  island: { slug: string; name: string };
  place: HubPlace;
  parent?: HubPlace | null;
  children?: HubPlace[];
  businesses: {
    slug: string;
    name: string;
    summary: string;
    categories: string[];
    status?: string;
    sample?: boolean;
    fieldRegistered?: boolean;
  }[];
};

let hub: PlaceHubPayload | null = null;
let placeSlug = hostPlaceSlug!;
let slug = pathParts[0]!;

if (!areaFacet) {
if (pathParts.length === 1) {
  const child = islandDetail.places.find(
    (p) =>
      p.slug === pathParts[0] &&
      p.parentPlaceId === hostPlace.id &&
      p.type === "tourist_area",
  );
  if (child) {
    hub = await apiOrNull<PlaceHubPayload>(
      `/v1/islands/${islandSlug}/places/${child.slug}`,
    );
    if (!hub) return Astro.rewrite(withLocale("/404", locale));
  }
} else if (!isFacetBrowse) {
  const areaSlug = pathParts[0]!;
  const areaPlace = islandDetail.places.find((p) => p.slug === areaSlug);
  if (!areaPlace) return Astro.rewrite(withLocale("/404", locale));
  const areaNest = geoNesting(areaPlace, placesById);
  if (areaNest.hostPlace !== hostPlaceSlug || !areaNest.area) {
    if (areaNest.area) {
      return Astro.redirect(
        withLocale(
          seoHostPath({
            island: islandSlug!,
            place: areaNest.hostPlace,
            area: areaNest.area,
            slug: pathParts[1],
          }),
          locale,
        ),
        301,
      );
    }
    return Astro.rewrite(withLocale("/404", locale));
  }
  placeSlug = areaSlug;
  slug = pathParts[1]!;
}
}

type ListingPayload = {
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    description: string;
    categories: string[];
    address?: string;
    phone?: string;
    whatsapp?: string;
    website?: string;
    lat?: number;
    lng?: number;
    gallery?: string[];
    bookingMode: string;
    status: string;
    sample?: boolean;
    verifiedAt?: string;
    openingHours: { day: string; open: string; close: string; closed?: boolean }[];
  };
  reviews: {
    authorName: string;
    service: number;
    value: number;
    location: number;
    cleanliness: number;
    comment: string;
  }[];
  vendor?: {
    id: string;
    name: string;
    description: string;
    products: { name: string; price: number; currency: string; stock: number; description: string }[];
  };
};

const data = hub || areaFacet
  ? null
  : await apiOrNull<ListingPayload>(
      `/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}`,
    );
if (!hub && !areaFacet && !data) return Astro.rewrite(withLocale("/404", locale));

const placeMeta = hub || areaFacet
  ? null
  : await apiOrNull<{
      island: { name: string; slug: string };
      place: HubPlace;
      parent?: HubPlace | null;
    }>(`/v1/islands/${islandSlug}/places/${placeSlug}`);
if (data && !placeMeta) return Astro.rewrite(withLocale("/404", locale));

const listingNest = placeMeta
  ? geoNesting(placeMeta.place, {
      [placeMeta.place.id]: placeMeta.place,
      ...(placeMeta.parent ? { [placeMeta.parent.id]: placeMeta.parent } : {}),
    })
  : hostNest;

const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
const listingUrl = tenantAbsHref(req, {
  island: islandSlug!,
  place: listingNest.hostPlace,
  area: listingNest.area,
  slug: data ? slug : undefined,
  locale,
});
const listingLocationMarkers =
  data && "lat" in (data.business ?? {})
    ? takeMarkers([
        listingMarker({
          lat: data.business.lat,
          lng: data.business.lng,
          name: data.business.name,
        }),
      ])
    : [];
const bookingToday = new Date().toISOString().slice(0, 10);
const listingCopy = {
  reviewSubmitting: t(locale, "reviewSubmitting"),
  reviewTooMany: t(locale, "reviewTooMany"),
  reviewTooManyRetry: t(locale, "reviewTooManyRetry"),
  networkRetry: t(locale, "networkRetry"),
  bookingSending: t(locale, "bookingSending"),
  bookingPendingOk: t(locale, "bookingPendingOk"),
  tooManyKept: t(locale, "tooManyKept"),
  tooManyRetryKept: t(locale, "tooManyRetryKept"),
  networkKept: t(locale, "networkKept"),
  reportSending: t(locale, "reportSending"),
  reportReceived: t(locale, "reportReceived"),
  reportNetwork: t(locale, "reportNetwork"),
  bookingPastDate: t(locale, "bookingPastDate"),
  bookingNeedEndDate: t(locale, "bookingNeedEndDate"),
  bookingNeedTickets: t(locale, "bookingNeedTickets"),
  bookingEndBeforeStart: t(locale, "bookingEndBeforeStart"),
  bookingDuplicate: t(locale, "bookingDuplicate"),
  bookingDisabled: t(locale, "bookingDisabled"),
  bookingRejected: t(locale, "bookingRejected"),
  reviewFailed: t(locale, "reviewFailed"),
  reportFailed: t(locale, "reportFailed"),
  requestFailed: t(locale, "requestFailed"),
  mapHere: t(locale, "mapHere"),
  kmAway: t(locale, "kmAway"),
};

type DiscoveryNeighbor = {
  business: {
    id: string;
    name: string;
    slug: string;
    summary: string;
    categories: string[];
    lat?: number;
    lng?: number;
  };
  place: { slug: string; name: string };
  island: { slug: string };
  geo?: { hostPlace: string; area?: string };
  distanceKm: number;
};

type DiscoveryPayload = {
  origin: { lat: number; lng: number; address?: string } | null;
  sameAddress: DiscoveryNeighbor[];
  similar: DiscoveryNeighbor[];
  nearbyCategories: string[];
  nearby: DiscoveryNeighbor[];
  activeCategory: string | null;
  radiusKm: number;
};

const emptyDiscovery: DiscoveryPayload = {
  origin: null,
  sameAddress: [],
  similar: [],
  nearbyCategories: [],
  nearby: [],
  activeCategory: null,
  radiusKm: 0,
};

const discovery = data
  ? await api<DiscoveryPayload>(
      `/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}/discovery`,
    ).catch(() => emptyDiscovery)
  : emptyDiscovery;

function neighborHref(n: DiscoveryNeighbor) {
  return tenantHref(req, {
    island: n.island.slug,
    place: n.geo?.hostPlace ?? n.place.slug,
    area: n.geo?.area,
    slug: n.business.slug,
    locale,
  });
}

const discoveryApi = data
  ? `${browserApiOrigin()}/v1/islands/${islandSlug}/places/${placeSlug}/businesses/${slug}/discovery`
  : "";

const HREF_TOKEN = {
  island: "x-island-x",
  place: "x-place-x",
  area: "x-area-x",
  slug: "x-slug-x",
};
const neighborHrefTemplate = tenantHref(req, {
  island: HREF_TOKEN.island,
  place: HREF_TOKEN.place,
  area: HREF_TOKEN.area,
  slug: HREF_TOKEN.slug,
  locale,
});

const nearbySeed = JSON.stringify({
  origin: discovery.origin,
  nearby: discovery.nearby.map((n) => ({
    business: {
      name: n.business.name,
      slug: n.business.slug,
      summary: n.business.summary,
      lat: n.business.lat,
      lng: n.business.lng,
    },
    place: { slug: n.place.slug, name: n.place.name },
    island: { slug: n.island.slug },
    geo: n.geo,
    distanceKm: n.distanceKm,
  })),
});
const nearbyWithHref = discovery.nearby.map((n) => ({
  ...n,
  href: neighborHref(n),
}));

const hubCanonical =
  hub &&
  tenantAbsHref(req, {
    island: hub.island.slug,
    place: hostPlaceSlug!,
    area: hub.place.slug,
    locale,
  });
const hubQuery = hub
  ? publicHostLine({
      island: hub.island.slug,
      place: hostPlaceSlug!,
      area: hub.place.slug,
    })
  : "";

if (hub && categoryParam) {
  const slug = canonicalizeCategory(categoryParam);
  if (slug) {
    return Astro.redirect(
      withLocale(
        seoHostPath({
          island: hub.island.slug,
          place: hostPlaceSlug!,
          area: hub.place.slug,
          category: slug,
        }),
        locale,
      ),
      301,
    );
  }
}
---
{areaFacet && (
  <Base
    title={`${inWhere(locale, areaFacet.titleCore, areaFacet.area.name)} — nusa.business`}
    description={`${areaFacet.listings.length} ${t(locale, "listingsCount")} ${t(locale, "inWhere")} ${areaFacet.area.name}.`}
    crumb={[
      {
        label: islandLabel,
        href: tenantHref(req, { island: islandSlug!, locale }),
      },
      {
        label: hostPlace.name,
        href: tenantHref(req, {
          island: islandSlug!,
          place: hostPlaceSlug!,
          locale,
        }),
      },
      {
        label: areaFacet.area.name,
        href: tenantHref(req, {
          island: islandSlug!,
          place: hostPlaceSlug!,
          area: areaFacet.area.slug,
          locale,
        }),
      },
      { label: areaFacet.titleCore },
    ]}
    locale={locale}
    canonical={areaFacet.canonical}
    robots={areaFacet.robots}
    jsonLd={[
      websiteJsonLd({
        locale,
        url: areaFacet.canonical,
        name: inWhere(locale, areaFacet.titleCore, areaFacet.area.name),
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: nationAbsHref(req, locale) },
        {
          name: islandLabel,
          url: tenantAbsHref(req, { island: islandSlug!, locale }),
        },
        {
          name: hostPlace.name,
          url: tenantAbsHref(req, {
            island: islandSlug!,
            place: hostPlaceSlug!,
            locale,
          }),
        },
        { name: areaFacet.area.name, url: areaFacet.canonical },
      ]),
    ]}
  >
    <CategoryBrowse
      island={islandDetail.island}
      hostPlace={hostPlace}
      area={areaFacet.area}
      places={islandDetail.places}
      listings={areaFacet.listings}
      listingPlaces={areaFacet.listingPlaces}
      browse={areaFacet.browse}
      locale={locale}
      formAction={areaFacet.formAction}
      unavailable={areaFacet.unavailable}
    />
  </Base>
)}
{hub && hubCanonical && (
  <Base
    title={`${hub.place.name}, ${islandLabel} — nusa.business`}
    description={hub.place.summary}
    crumb={[
      {
        label: islandLabel,
        href: tenantHref(req, { island: hub.island.slug, locale }),
      },
      {
        label: hostPlace.name,
        href: tenantHref(req, {
          island: hub.island.slug,
          place: hostPlaceSlug!,
          locale,
        }),
      },
      { label: hub.place.name },
    ]}
    locale={locale}
    canonical={hubCanonical}
    jsonLd={[
      websiteJsonLd({
        locale,
        url: hubCanonical,
        name: `${hub.place.name}, ${islandLabel}`,
        description: hub.place.summary,
      }),
      breadcrumbJsonLd([
        { name: "nusa.business", url: nationAbsHref(req, locale) },
        {
          name: islandLabel,
          url: tenantAbsHref(req, { island: hub.island.slug, locale }),
        },
        {
          name: hostPlace.name,
          url: tenantAbsHref(req, {
            island: hub.island.slug,
            place: hostPlaceSlug!,
            locale,
          }),
        },
        { name: hub.place.name, url: hubCanonical },
      ]),
    ]}
  >
    <PlaceDirectory
      island={hub.island}
      place={hub.place}
      parent={hub.parent}
      children={hub.children ?? []}
      businesses={hub.businesses}
      queryHost={hubQuery}
      locale={locale}
      categoryParam={categoryParam}
    />
  </Base>
)}
{data && placeMeta && (
<Base
  title={`${data.business.name} — ${placeMeta.place.name}`}
  description={data.business.summary}
  crumb={[
    { label: islandLabel, href: tenantHref(req, { island: islandSlug!, locale }) },
    ...(listingNest.area
      ? [
          {
            label: placeMeta.parent?.name ?? listingNest.hostPlace,
            href: tenantHref(req, {
              island: islandSlug!,
              place: listingNest.hostPlace,
              locale,
            }),
          },
          {
            label: placeMeta.place.name,
            href: tenantHref(req, {
              island: islandSlug!,
              place: listingNest.hostPlace,
              area: listingNest.area,
              locale,
            }),
          },
        ]
      : [
          {
            label: placeMeta.place.name,
            href: tenantHref(req, {
              island: islandSlug!,
              place: listingNest.hostPlace,
              locale,
            }),
          },
        ]),
    { label: data.business.name },
  ]}
  locale={locale}
  canonical={listingUrl}
  ogType="article"
  jsonLd={[
    localBusinessJsonLd({
      name: data.business.name,
      description: data.business.summary,
      url: listingUrl,
      address: data.business.address,
      telephone: data.business.phone,
      categories: data.business.categories,
      lat: data.business.lat,
      lng: data.business.lng,
      locale,
      openingHours: data.business.openingHours,
    }),
    breadcrumbJsonLd([
      { name: "nusa.business", url: nationAbsHref(req, locale) },
      {
        name: islandLabel,
        url: tenantAbsHref(req, { island: islandSlug!, locale }),
      },
      {
        name: listingNest.area
          ? (placeMeta.parent?.name ?? listingNest.hostPlace)
          : placeMeta.place.name,
        url: tenantAbsHref(req, {
          island: islandSlug!,
          place: listingNest.hostPlace,
          locale,
        }),
      },
      ...(listingNest.area
        ? [
            {
              name: placeMeta.place.name,
              url: tenantAbsHref(req, {
                island: islandSlug!,
                place: listingNest.hostPlace,
                area: listingNest.area,
                locale,
              }),
            },
          ]
        : []),
      { name: data.business.name, url: listingUrl },
    ]),
  ]}
>
  <ListingRecord
    locale={locale}
    business={data.business}
    reviews={data.reviews}
    vendor={data.vendor}
    placeName={placeMeta.place.name}
    islandLabel={islandLabel}
    portal={portal}
    discovery={discovery}
    nearbyWithHref={nearbyWithHref}
    nearbySeed={nearbySeed}
    neighborHrefTemplate={neighborHrefTemplate}
    discoveryApi={discoveryApi}
    listingLocationMarkers={listingLocationMarkers}
    listingCopy={listingCopy}
    apiBase={browserApiOrigin()}
    neighborHref={neighborHref}
    bookingToday={bookingToday}
  />
</Base>
)}

