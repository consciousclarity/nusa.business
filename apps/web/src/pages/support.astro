---
import Base from "../layouts/Base.astro";
import { absoluteUrl } from "../lib/seo";
import { t, withLocale, type Locale } from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const url = absoluteUrl(Astro.request, withLocale("/support", locale));
const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
---
<Base
  title={t(locale, "supportTitle")}
  description="How to contact nusa.business about listings, claims, and corrections."
  canonical={url}
  locale={locale}
>
  <section class="lede">
    <h1>{t(locale, "support")}</h1>
    <p class="prose">
      Visitors can suggest a correction on a listing page. Owners sign in to
      the portal to claim or edit their own businesses after approval.
    </p>
  </section>
  <section class="section">
    <h2>Owner onboarding</h2>
    <p class="prose">
      Registration is invite-only in this launch. Request an invite from an
      operator, then <a href={`${portal}/register`}>redeem it</a>. Sign-in and
      password recovery live on the same portal.
    </p>
    <p class="actions">
      <a class="cta" href={`${portal}/login`}>{t(locale, "claimLogin")}</a>
      <a class="cta secondary" href={withLocale("/claim", locale)}>
        {t(locale, "claimListing")}
      </a>
    </p>
  </section>
</Base>
