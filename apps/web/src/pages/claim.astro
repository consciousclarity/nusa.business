---
import Base from "../layouts/Base.astro";
import { absoluteUrl } from "../lib/seo";

const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
const claimUrl = absoluteUrl(Astro.request, "/claim");
const claimDescription =
  "Field teams register businesses for free. Owners claim listings at no cost — customize details, reply to reviews, and optionally open a vendor shop.";
---
<Base
  title="Claim a listing — nusa.business"
  description={claimDescription}
  canonical={claimUrl}
>
  <section class="lede">
    <h1>Claim a listing</h1>
    <p class="prose">
      Field teams register businesses for free. Owners claim listings at no cost —
      customize details, reply to reviews, and optionally open a vendor shop.
    </p>
  </section>

  <aside class="resolver" aria-label="Claim entry">
    <dl>
      <dt>Query</dt>
      <dd>claim</dd>
      <dt>Resolved</dt>
      <dd>action=claim · fee=0 · commission=0%</dd>
      <dt>Next</dt>
      <dd>portal authentication</dd>
    </dl>
  </aside>

  <p class="actions">
    <a class="cta" href={`${portal}/claim`}>Open claim portal</a>
    <a class="cta secondary" href={`${portal}/login?returnTo=${encodeURIComponent("/claim")}`}>Owner login</a>
    <a class="cta secondary" href={`${portal}/register`}>Have an invite?</a>
  </p>
</Base>
