{
  "name": "Nusa.Business",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8787, 4321, 5173],
  "portsAttributes": {
    "8787": {
      "label": "api (Hono)",
      "onAutoForward": "silent",
      // The portal is a browser-side SPA, so it calls the API from outside the
      // container. That only works if this port is reachable without a
      // Codespaces auth cookie.
      "visibility": "public"
    },
    "4321": { "label": "web (Astro)", "onAutoForward": "notify" },
    "5173": { "label": "portal (React Router)", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": false
      }
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  }
}
