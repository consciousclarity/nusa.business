---
import { TAXONOMY, categoryLabel } from "@nusa/shared";
import { apiTry } from "../lib/api";
import { islandName, t, withLocale, type Locale } from "../i18n/ui";

export type DirectorySearchProvince = {
  slug: string;
  name: string;
  status?: string;
  kind?: string;
};

type Props = {
  locale: Locale;
  island?: string;
  category?: string;
  q?: string;
  /** Preselect the current province; the control stays in the same layout. */
  lockIsland?: boolean;
  /** Skip the islands fetch when the page already loaded provinces. */
  provinces?: DirectorySearchProvince[];
};

type IslandsResponse = {
  islands?: DirectorySearchProvince[];
  provinces?: DirectorySearchProvince[];
};

const {
  locale,
  island = "",
  category = "",
  q = "",
  lockIsland = false,
  provinces: provincesProp,
} = Astro.props as Props;

function activeProvinces(rows: DirectorySearchProvince[]): DirectorySearchProvince[] {
  return rows.filter(
    (row) => row.kind !== "region" && (row.status === "active" || !row.status),
  );
}

let provinces = provincesProp ? activeProvinces(provincesProp) : [];
if (!provincesProp) {
  const data = await apiTry<IslandsResponse>("/v1/islands");
  provinces = activeProvinces(data?.provinces ?? data?.islands ?? []);
}

const knownProvince = provinces.some((row) => row.slug === island);
const locked = Boolean(lockIsland && island && (knownProvince || provinces.length === 0));
const lockedLabel = islandName(
  locale,
  island,
  provinces.find((row) => row.slug === island)?.name ?? island,
);
const lookingFor = t(locale, "searchLookingFor");
const action = withLocale("/search", locale);
---

<form class="directory-search" method="get" action={action} role="search">
  {locked && <input type="hidden" name="island" value={island} />}
  <label class="query">
    <span class="vh">{lookingFor}</span>
    <input
      class="control"
      type="search"
      name="q"
      value={q}
      placeholder={lookingFor}
      autocomplete="off"
      maxlength="120"
    />
  </label>
  <label class="facet">
    <span class="vh">{t(locale, "island")}</span>
    {locked ? (
      <select class="control" disabled>
        <option value={island} selected>{lockedLabel}</option>
      </select>
    ) : (
      <select class="control" name="island">
        <option value="">{t(locale, "allIslands")}</option>
        {provinces.map((row) => (
          <option value={row.slug} selected={row.slug === island}>
            {islandName(locale, row.slug, row.name)}
          </option>
        ))}
      </select>
    )}
  </label>
  <label class="facet">
    <span class="vh">{t(locale, "category")}</span>
    <select class="control" name="category">
      <option value="">{t(locale, "allCategories")}</option>
      {TAXONOMY.map((group) => (
        <option value={group.slug} selected={group.slug === category}>
          {categoryLabel(group.slug, locale)}
        </option>
      ))}
    </select>
  </label>
  <button type="submit">{t(locale, "search")}</button>
</form>

<style>
  .directory-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9.5rem, 12.5rem) minmax(9.5rem, 12.5rem) auto;
    gap: 0.65rem;
    align-items: stretch;
    margin: 0 0 1.25rem;
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  label {
    position: relative;
    display: block;
    min-width: 0;
    margin: 0;
    color: var(--ink-soft);
  }

  .control,
  button {
    display: block;
    width: 100%;
    max-width: none;
    height: 2.75rem;
    min-height: 2.75rem;
    box-sizing: border-box;
    margin: 0;
    padding: 0 0.85rem;
    font-family: var(--mono);
    font-size: 1rem;
    line-height: calc(2.75rem - 2px);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
  }

  input[type="search"].control::-webkit-search-decoration {
    -webkit-appearance: none;
  }

  select.control {
    padding-inline-end: 2rem;
  }

  .facet::after {
    content: "";
    position: absolute;
    right: 0.75rem;
    top: 50%;
    width: 0;
    height: 0;
    border: 0.28rem solid transparent;
    border-top-color: var(--ink);
    border-bottom-width: 0;
    pointer-events: none;
    transform: translateY(-35%);
  }

  button {
    width: auto;
    padding-inline: 1.1rem;
    color: var(--paper);
    background: var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  button:hover {
    background: var(--link);
    border-color: var(--link);
  }

  .control:focus,
  .control:focus-visible,
  button:focus,
  button:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }

  @media (max-width: 40rem) {
    .directory-search {
      grid-template-columns: 1fr 1fr;
    }

    .query,
    button {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 22rem) {
    .directory-search {
      grid-template-columns: 1fr;
    }

    .query,
    button {
      grid-column: auto;
    }
  }
</style>
