# Local reverse-proxy sketch for multi-level hosts.
# Point apps to host.docker.internal when running API/web on the host.
# Production: terminate TLS for *.nusa.business and *.*.nusa.business.

:80 {
  @api host api.localhost
  handle @api {
    reverse_proxy host.docker.internal:8787
  }

  @portal host portal.localhost
  handle @portal {
    reverse_proxy host.docker.internal:5173
  }

  handle {
    reverse_proxy host.docker.internal:4321
  }
}
