---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import { publicUrl } from "@nusa/shared";
import { resolveRequestContext } from "../lib/tenant";
import { absoluteUrl, websiteJsonLd } from "../lib/seo";
import { t, withLocale, type Locale } from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const { context } = resolveRequestContext(Astro.request, Astro.url);

// Island/place hosts are rewritten to /host/... by middleware — nation only here.
if (context.kind !== "nation") {
  return Astro.redirect(withLocale("/", locale));
}

const data = await api<{
  islands: { slug: string; name: string; tagline: string; status: string }[];
}>("/v1/islands");

const queryHost = (
  Astro.request.headers.get("x-forwarded-host") ||
  Astro.request.headers.get("host") ||
  "nusa.business"
)
  .split(":")[0]!
  .toLowerCase();
const useRealHosts =
  queryHost === "nusa.business" || queryHost.endsWith(".nusa.business");
const active = data.islands.filter((i) => i.status === "active").length;
const pending = data.islands.length - active;

function islandHref(slug: string) {
  if (useRealHosts) {
    const absolute = publicUrl({ island: slug });
    if (locale === "en") return absolute;
    const u = new URL(absolute);
    u.pathname = withLocale(u.pathname || "/", "id");
    return u.toString();
  }
  return withLocale(`/host/${slug}`, locale);
}

const nationUrl = absoluteUrl(Astro.request, withLocale("/", locale));
const nationDescription = t(locale, "nationLede");
---
<Base
  title={t(locale, "nationTitle")}
  description={nationDescription}
  canonical={nationUrl}
  locale={locale}
  jsonLd={websiteJsonLd({ url: nationUrl, description: nationDescription })}
>
  <section class="lede">
    <h1>{t(locale, "nationH1")}</h1>
    <p class="prose">{t(locale, "nationLede")}</p>
  </section>

  <aside class="resolver" aria-label={t(locale, "hostResolver")}>
    <dl>
      <dt>{t(locale, "query")}</dt>
      <dd>{queryHost}</dd>
      <dt>{t(locale, "resolved")}</dt>
      <dd>kind=nation</dd>
      <dt>{t(locale, "records")}</dt>
      <dd>{active} active islands · {pending} pending</dd>
    </dl>
  </aside>

  <section class="section">
    <h2>{t(locale, "islands")}</h2>
    <ol class="index-list">
      {data.islands.map((island, i) => (
        <li>
          <div class="index-row">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <a class="name" href={islandHref(island.slug)}>{island.name}</a>
            <span class="rhs">
              {island.status === "active" ? (
                <span>{island.slug}.nusa.business</span>
              ) : (
                <span class="stamp">{t(locale, "comingSoon")}</span>
              )}
            </span>
          </div>
          <p class="index-desc">{island.tagline}</p>
        </li>
      ))}
    </ol>
    <p class="actions">
      <a class="cta" href={withLocale("/claim", locale)}>{t(locale, "claimListing")}</a>
      <a class="cta secondary" href={islandHref("bali")}>{t(locale, "openBali")}</a>
    </p>
  </section>
</Base>
