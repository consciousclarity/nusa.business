---
import Base from "../layouts/Base.astro";
import DirectoryMap from "../components/DirectoryMap.astro";
import { apiTry } from "../lib/api";
import { tenantHref } from "../lib/links";
import { INDONESIA_VIEW, geoView } from "../lib/geo-centroids";
import { listingMarker, placeMarker, takeMarkers } from "../lib/map-markers";
import { TAXONOMY, categoryLabel } from "@nusa/shared";
import { resolveRequestContext } from "../lib/tenant";
import { absoluteUrl, websiteJsonLd } from "../lib/seo";
import {
  islandName,
  islandTagline,
  regionName,
  t,
  withLocale,
  type Locale,
} from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const req = Astro.request;
const { context } = resolveRequestContext(req, Astro.url);

if (context.kind !== "nation") {
  return Astro.redirect(withLocale("/", locale));
}

type Hub = {
  slug: string;
  name: string;
  tagline: string;
  status: string;
  kind?: string;
  region?: string;
};

type NationHit = {
  business: { slug: string; name: string; lat?: number; lng?: number };
  island?: { slug: string; name: string };
  geo?: { hostPlace: string; area?: string };
};

const [data, search] = await Promise.all([
  apiTry<{
    islands: Hub[];
    provinces?: Hub[];
  }>("/v1/islands"),
  apiTry<{ results: NationHit[] }>("/v1/search"),
]);
const provinces = (data?.provinces ?? (data?.islands ?? []).filter((i) => i.kind !== "region")).filter(
  (i) => i.status === "active",
);
const directoryUp = data !== null;
const baliHref = tenantHref(req, { island: "bali", locale });
const nationUrl = absoluteUrl(req, withLocale("/", locale));
const nationDescription = t(locale, "nationLede");
const searchAction = withLocale("/search", locale);

const regionOrder = [
  "sumatra",
  "java",
  "bali",
  "nusa-tenggara",
  "kalimantan",
  "sulawesi",
  "maluku",
  "papua",
];
const grouped = regionOrder
  .map((region) => ({
    region,
    hubs: provinces.filter((p) => (p.region ?? p.slug) === region),
  }))
  .filter((g) => g.hubs.length > 0);
const leftover = provinces.filter(
  (p) => !regionOrder.includes(p.region ?? p.slug),
);
const nationMarkers = takeMarkers([
  ...provinces.map((p) => {
    const view = geoView(p.slug);
    return placeMarker({
      lat: view.lat,
      lng: view.lng,
      name: islandName(locale, p.slug, p.name),
      href: tenantHref(req, { island: p.slug, locale }),
    });
  }),
  ...(search?.results ?? []).map((hit) =>
    hit.island && hit.geo
      ? listingMarker({
          lat: hit.business.lat,
          lng: hit.business.lng,
          name: hit.business.name,
          href: tenantHref(req, {
            island: hit.island.slug,
            place: hit.geo.hostPlace,
            area: hit.geo.area,
            slug: hit.business.slug,
            locale,
          }),
        })
      : null,
  ),
]);
---
<Base
  title={t(locale, "nationTitle")}
  description={nationDescription}
  canonical={nationUrl}
  locale={locale}
  jsonLd={websiteJsonLd({
    url: nationUrl,
    description: nationDescription,
    locale,
  })}
>
  <section class="lede">
    <h1>{t(locale, "nationH1")}</h1>
    <p class="prose">{t(locale, "nationLede")}</p>
  </section>

  <form class="section filter-bar" method="get" action={searchAction}>
    <label>
      {t(locale, "findBusiness")}
      <input
        type="search"
        name="q"
        placeholder={t(locale, "searchPlaceholder")}
        autocomplete="off"
        maxlength="120"
      />
    </label>
    <label>
      {t(locale, "island")}
      <select name="island">
        <option value="">{t(locale, "allIslands")}</option>
        {provinces.map((island) => (
          <option value={island.slug}>{islandName(locale, island.slug, island.name)}</option>
        ))}
      </select>
    </label>
    <label>
      {t(locale, "category")}
      <select name="category">
        <option value="">{t(locale, "allCategories")}</option>
        {TAXONOMY.map((group) => (
          <option value={group.slug}>{categoryLabel(group.slug, locale)}</option>
        ))}
      </select>
    </label>
    <button type="submit">{t(locale, "search")}</button>
  </form>

  {directoryUp && (
    <DirectoryMap
      label={t(locale, "directoryMap")}
      markers={nationMarkers}
      fallback={INDONESIA_VIEW}
    />
  )}

  <section class="section">
    <h2>{t(locale, "provinces")}</h2>
    <p class="prose">
      {provinces.length} {t(locale, "provinces").toLowerCase()} · {t(locale, "regenciesCities")}
    </p>
    {directoryUp ? (
      grouped.map((group) => (
        <section class="section">
          <h3>{regionName(locale, group.region)}</h3>
          <ol class="index-list">
            {group.hubs.map((island, i) => (
              <li>
                <div class="index-row">
                  <span class="n">{String(i + 1).padStart(2, "0")}</span>
                  <a class="name" href={tenantHref(req, { island: island.slug, locale })}>
                    {islandName(locale, island.slug, island.name)}
                  </a>
                  <span class="rhs">
                    <span>{island.slug}.nusa.business</span>
                  </span>
                </div>
                <p class="index-desc">
                  {islandTagline(locale, island.slug, island.tagline)}
                </p>
              </li>
            ))}
          </ol>
        </section>
      ))
    ) : (
      <p class="prose">{t(locale, "directoryUnavailable")}</p>
    )}
    {leftover.length > 0 && (
      <ol class="index-list">
        {leftover.map((island, i) => (
          <li>
            <div class="index-row">
              <span class="n">{String(i + 1).padStart(2, "0")}</span>
              <a class="name" href={tenantHref(req, { island: island.slug, locale })}>
                {islandName(locale, island.slug, island.name)}
              </a>
              <span class="rhs"><span>{island.slug}.nusa.business</span></span>
            </div>
          </li>
        ))}
      </ol>
    )}
    <p class="actions">
      <a class="cta" href={baliHref}>{t(locale, "openBali")}</a>
      <a class="cta secondary" href={withLocale("/claim", locale)}>
        {t(locale, "addListing")}
      </a>
    </p>
  </section>
</Base>
