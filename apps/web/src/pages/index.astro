---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import { resolveRequestContext } from "../lib/tenant";

const { context, pathname } = resolveRequestContext(Astro.request, Astro.url);

if (context.kind === "island") {
  return Astro.redirect(`/host/${context.island}${pathname === "/" ? "" : pathname}`);
}
if (context.kind === "place") {
  return Astro.redirect(
    `/host/${context.place}.${context.island}${pathname === "/" ? "" : pathname}`,
  );
}

const data = await api<{
  islands: { slug: string; name: string; tagline: string; status: string }[];
}>("/v1/islands");

const host =
  Astro.request.headers.get("x-forwarded-host") ||
  Astro.request.headers.get("host") ||
  "nusa.business";
const queryHost = host.split(":")[0]!.toLowerCase();
const active = data.islands.filter((i) => i.status === "active").length;
const pending = data.islands.length - active;
---
<Base title="nusa.business — Local businesses across Indonesia">
  <section class="lede">
    <h1>Indonesia</h1>
    <p class="prose">
      Local business directory indexed by nested geography — nation, island,
      place, record. Free listings. No commission at launch.
    </p>
  </section>

  <aside class="resolver" aria-label="Host resolver">
    <dl>
      <dt>Query</dt>
      <dd>{queryHost}</dd>
      <dt>Resolved</dt>
      <dd>kind=nation</dd>
      <dt>Records</dt>
      <dd>{active} active islands · {pending} pending</dd>
    </dl>
  </aside>

  <section class="section">
    <h2>Islands</h2>
    <ol class="index-list">
      {data.islands.map((island, i) => (
        <li>
          <div class="index-row">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <a class="name" href={`/host/${island.slug}`}>{island.name}</a>
            <span class="rhs">
              {island.status === "active" ? (
                <span>{island.slug}.nusa.business</span>
              ) : (
                <span class="stamp">Coming soon</span>
              )}
            </span>
          </div>
          <p class="index-desc">{island.tagline}</p>
        </li>
      ))}
    </ol>
    <p class="actions">
      <a class="cta" href="/claim">Claim a listing</a>
      <a class="cta secondary" href="/host/bali">Open bali index</a>
    </p>
  </section>
</Base>
