---
import Base from "../layouts/Base.astro";
import { apiTry } from "../lib/api";
import { tenantHref } from "../lib/links";
import { TAXONOMY, categoryLabel } from "@nusa/shared";
import { resolveRequestContext } from "../lib/tenant";
import { absoluteUrl, websiteJsonLd } from "../lib/seo";
import { islandName, islandTagline, t, withLocale, type Locale } from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const req = Astro.request;
const { context } = resolveRequestContext(req, Astro.url);

// Island/place hosts are rewritten to /host/... by middleware — nation only here.
if (context.kind !== "nation") {
  return Astro.redirect(withLocale("/", locale));
}

const data = await apiTry<{
  islands: { slug: string; name: string; tagline: string; status: string }[];
}>("/v1/islands");
const islands = data?.islands ?? [];
const directoryUp = data !== null;
const active = islands.filter((i) => i.status === "active");
const baliHref = tenantHref(req, { island: "bali", locale });
const nationUrl = absoluteUrl(req, withLocale("/", locale));
const nationDescription = t(locale, "nationLede");
const searchAction = withLocale("/search", locale);
---
<Base
  title={t(locale, "nationTitle")}
  description={nationDescription}
  canonical={nationUrl}
  locale={locale}
  jsonLd={websiteJsonLd({
    url: nationUrl,
    description: nationDescription,
    locale,
  })}
>
  <section class="lede">
    <h1>{t(locale, "nationH1")}</h1>
    <p class="prose">{t(locale, "nationLede")}</p>
  </section>

  <form class="section filter-bar" method="get" action={searchAction}>
    <label>
      {t(locale, "findBusiness")}
      <input
        type="search"
        name="q"
        placeholder={t(locale, "searchPlaceholder")}
        autocomplete="off"
        maxlength="120"
      />
    </label>
    <label>
      {t(locale, "island")}
      <select name="island">
        <option value="">{t(locale, "allIslands")}</option>
        {active.map((island) => (
          <option value={island.slug}>{islandName(locale, island.slug, island.name)}</option>
        ))}
      </select>
    </label>
    <label>
      {t(locale, "category")}
      <select name="category">
        <option value="">{t(locale, "allCategories")}</option>
        {TAXONOMY.map((group) => (
          <option value={group.slug}>{categoryLabel(group.slug, locale)}</option>
        ))}
      </select>
    </label>
    <button type="submit">{t(locale, "search")}</button>
  </form>

  <section class="section">
    <h2>{t(locale, "islands")}</h2>
    {directoryUp ? (
    <ol class="index-list">
      {islands.map((island, i) => (
        <li>
          <div class="index-row">
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            {island.status === "active" ? (
              <a class="name" href={tenantHref(req, { island: island.slug, locale })}>{islandName(locale, island.slug, island.name)}</a>
            ) : (
              <span class="name">{islandName(locale, island.slug, island.name)}</span>
            )}
            <span class="rhs">
              {island.status === "active" ? (
                <span>{island.slug}.nusa.business</span>
              ) : (
                <span class="stamp">{t(locale, "comingSoon")}</span>
              )}
            </span>
          </div>
          <p class="index-desc">
            {island.status === "active"
              ? islandTagline(locale, island.slug, island.tagline)
              : t(locale, "comingSoonNext")}
            {island.status !== "active" && (
              <>
                {" "}
                <a href={baliHref}>{t(locale, "browseBali")}</a>
              </>
            )}
          </p>
        </li>
      ))}
    </ol>
    ) : (
      <p class="prose">{t(locale, "directoryUnavailable")}</p>
    )}
    <p class="actions">
      <a class="cta" href={baliHref}>{t(locale, "openBali")}</a>
      <a class="cta secondary" href={withLocale("/claim", locale)}>
        {t(locale, "addListing")}
      </a>
    </p>
  </section>
</Base>
