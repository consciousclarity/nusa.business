---
import Base from "../layouts/Base.astro";
import { t, type Locale } from "../i18n/ui";

const locale: Locale = Astro.locals.locale ?? "en";
const portal = import.meta.env.PUBLIC_PORTAL_URL || "http://localhost:5173";
---
<Base title={t(locale, "claimTitle")} locale={locale}>
  <section class="lede">
    <h1>{t(locale, "claimH1")}</h1>
    <p class="prose">{t(locale, "claimLede")}</p>
  </section>

  <aside class="resolver" aria-label={t(locale, "hostResolver")}>
    <dl>
      <dt>{t(locale, "query")}</dt>
      <dd>claim</dd>
      <dt>{t(locale, "resolved")}</dt>
      <dd>action=claim · fee=0 · commission=0%</dd>
      <dt>{t(locale, "records")}</dt>
      <dd>portal authentication</dd>
    </dl>
  </aside>

  <p class="actions">
    <a class="cta" href={`${portal}/claim`}>{t(locale, "claimOpen")}</a>
    <a class="cta secondary" href={`${portal}/login?returnTo=${encodeURIComponent("/claim")}`}>{t(locale, "claimLogin")}</a>
    <a class="cta secondary" href={`${portal}/register`}>{t(locale, "claimInvite")}</a>
  </p>
</Base>
